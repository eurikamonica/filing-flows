":"LTRX:EmbeddedIoTSolutionsMember","label":"Embedded IoT Solutions"},{"id":"LTRX:SoftwareAndServicesMember","label":"Software & Services"}],"groups":[],"axis":"ProductOrServiceAxis"},"lines":{"LTRX:IoTSystemSolutionsMember":58270000.0,"LTRX:EmbeddedIoTSolutionsMember":53607000.0,"LTRX:SoftwareAndServicesMember":9022000.0},"lines_py":{"LTRX:IoTSystemSolutionsMember":68735000.0,"LTRX:EmbeddedIoTSolutionsMember":46380000.0,"LTRX:SoftwareAndServicesMember":7808000.0},"notes":{}}},"keep":7,"hist":2,"intro":{"text":"Lantronix Inc. (NASDAQ: LTRX) is a global leader in Edge AI and Industrial IoT solutions that power NDAA-compliant unmanned systems, critical infrastructure and resilient enterprise networks. It delivers intelligent computing, secure connectivity and remote management for mission-critical applications enabling customers to optimize operations, enhance security and accelerate digital transformation. Its comprehensive portfolio of hardware, software and services powers applications ranging from mission-critical autonomous platforms and edge analytics for critical infrastructure to intelligent surveillance and secure network management. By bringing intelligence to the network edge, Lantronix helps organizations achieve efficiency, security and a competitive edge in today\u2019s AI-driven world. For more information, visit the Lantronix website.","url":"https://www.sec.gov/Archives/edgar/data/1114925/000168316826006732/lantronix_ex9901.htm","filed":"2026-08-26","source":"8-K"},"da_v":2}