        {
          "type": "interest_coverage",
          "limit": 3.0,
          "unit": "x",
          "direction": "max",
          "maintenance": true,
          "text": "As of the end of each fiscal quarter ending on or after June 30, 2025, the Interest Coverage Ratio shall be equal to or greater than 3.00 to 1.00."
