{"quarters":{"2026-06-30":{"end":"2026-06-30","label":"Q1 FY27","fq":1,"fy":2027,"cal":"CY2026Q2","form":"10-Q","accn":"0001213900-26-090479","filed":"2026-08-17","doc_url":"https://www.sec.gov/Archives/edgar/data/1848275/000121390026090479/ea0301938-10q_topfin.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1848275/000121390026090479/0001213900-26-090479-index.htm","raw":{"revenue":1076700,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":1463654,"oi":-386954,"pretax":null,"tax":-273229,"ni":-113433,"pl":-113725,"nci":-292,"ocf":6034786,"da":57646,"dep":57646,"amort":null,"sbc":null,"rev_contract":612271,"capex":3112},"q1_end":"2026-03-31","py_end":"2025-06-30","raw_q1":{"revenue":null,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":null,"oi":null,"pretax":null,"tax":null,"ni":null,"pl":null,"nci":null,"ocf":null,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":null,"capex":null},"raw_py":{"revenue":1333393,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":1247401,"oi":85992,"pretax":null,"tax":null,"ni":85992,"pl":85992,"nci":null,"ocf":7138236,"da":7472,"dep":7472,"amort":null,"sbc":null,"rev_contract":819117,"capex":null},"lines_struct":{"leaves":[{"id":"top:InterestIncomeFromLoanBusinessMember","label":"Interest income from loan business"},{"id":"top:OtherServiceRevenuesMember","label":"Other service revenues"},{"id":"top:CommissionOnFuturesBrokingFromOverseasExchangesMember","label":"Commission on futures broking from overseas Exchanges"},{"id":"top:VirtualAssetBrokerageCommissionsMember","label":"Virtual asset brokerage commissions"},{"id":"top:VirtualAssetBrokerageCcommissionsMember","label":"Virtual asset brokerage commissions"}],"groups":[],"axis":"ProductOrServiceAxis"},"lines":{"top:InterestIncomeFromLoanBusinessMember":416139.0,"top:OtherServiceRevenuesMember":374315.0,"top:CommissionOnFuturesBrokingFromOverseasExchangesMember":138343.0,"top:VirtualAssetBrokerageCommissionsMember":73755.0,"top:VirtualAssetBrokerageCcommissionsMember":73755.0},"lines_py":{"top:InterestIncomeFromLoanBusinessMember":237049.0,"top:OtherServiceRevenuesMember":30571.0,"top:CommissionOnFuturesBrokingFromOverseasExchangesMember":574321.0},"notes":{"pretax":[{"heading":"(Loss) income before income taxes","text":"We had a loss before income taxes of US$0.4 million and an income before income taxes US$0.1 million in the three months ended June 30, 2026 and 2025, respectively. Our operating margin was negative 35.9% and 6.4% in the three months ended June 30, 2026 and 2025, respectively."}],"tax":[{"heading":"(Loss) income before income taxes","text":"We had a loss before income taxes of US$0.4 million and an income before income taxes US$0.1 million in the three months ended June 30, 2026 and 2025, respectively. Our operating margin was negative 35.9% and 6.4% in the three months ended June 30, 2026 and 2025, respectively."}],"net":[{"heading":null,"text":"As a result of the foregoing, we reported net loss of US$0.1 million and net income of US$0.1 million for the three months ended June 30, 2026 and 2025, respectively."}],"ocf":[{"heading":"Operating activities","text":"Net cash provided by operating activities for the three months ended June 30, 2026 was US$6.0 million, as compared to the net loss of US$0.1 million. The difference was primarily attributable to changes in operating assets and liabilities including (i) an increase of US$12.3 million in loans receivables due from third party customers we expanded our loan business in the three months ended June 30, 2026, (ii) a decrease of US$12.2 million in receivables from broker-dealers and clearing organizations, and (iii) an increase of US$5.0 million in payables to customers due to an increase in futures accounts.\n\nNet cash provided by operating activities for the three months ended June 30, 2025 was US$7.1 million, as compared to the net income of US$0.1 million. The difference was primarily attributable to changes in operating assets and liabilities including (i) an increase of US$1.1 million in loans receivables due from third party customers, (ii) an increase of US$0.2 million in receivables from broker-dealers and clearing organizations, and (iii) an increase of US$8.9 million in payables to customers due to an increase in futures accounts."}],"sbc":[{"heading":null,"text":"Compensation and benefits represent the salaries, performance based discretionary bonuses and contribution to retirement fund, and share-based compensation expenses to non-executive directors. Compensation and benefits expenses accounted for 53.0% and 32.5% of our revenues for the three months ended June 30, 2026 and 2025, respectively."}],"net sales":[{"heading":"Revenues","text":"Our revenues consist of commissions, trading solution services and other service revenues, trading gains, interest income and others. The following table sets forth the breakdown of our total revenues, both in absolute amount and as a percentage of our total revenues, for the years indicated:"}],"Interest income from loan business":[{"heading":"Interest income from loan business","text":"For the year ended March 31, 2024, we launched the loan business to third party customers. The business was approved by the Hong Kong Licensing Court under the Money Lenders Ordinance. The Company disbursed loans to customers for a fixed period and charged interests from the customers. The principal and interest are repayable upon the maturity of the loans. We recognized interest income using straight-line method over loan period. For the three months ended June 30, 2026 and 2025, we recognized interest income of US$0.4 million and US$0.2 million from loan business, accounting for 38.6% and 17.8% of total revenues, respectively."}],"Other service revenues":[{"heading":"Other service revenues","text":"Other service revenues represent the revenues generated from rendering other financial services including securities brokerage, consulting services, and currency exchange services. We generally receive subscription fees calculated with reference to the amount subscribed by our clients of the structured products. For the three months ended June 30, 2026 and 2025, other service revenues accounted for 34.8% and 2.3% of total revenues, respectively.\n\nFor options trading, we have the capacity to offer options trading services and they are available to our clients. However, there was no revenue generated from options trading services for the relevant periods."}],"Virtual asset brokerage commissions":[{"heading":"Virtual asset brokerage commissions","text":"Virtual asset brokerage commissions represent commission income on virtual asset conversion from/into US dollar that are charged at a fixed rate for each transaction our customers executed through our online trading platforms, all of which are under the consolidated accounts where the customer information is not disclosed to the third-party broker. We receive commissions from customers. The virtual asset brokerage service cannot be cancelled once it has been executed and is not refundable, so returns and allowances are not applicable. Commissions are charged for each customer trade order executed. Commissions from virtual asset broking make up for most of our revenues at 6.9% of the total revenues for the three months ended June 30, 2026."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Purchases of fixed assets","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating Income (Loss)","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income tax benefits","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net (loss) income attributable to TOP Financial Group Limited\u2019s shareholders","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net Income (Loss), Including Portion Attributable to Noncontrolling Interest","ytd":false,"how":"xbrl"},"nci":{"c":"us-gaap:NetIncomeLossAttributableToNoncontrollingInterest","l":"Less: Net loss attributable to non-controlling shareholders","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net cash provided by operating activities","ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:Depreciation","l":"Depreciation","ytd":false,"how":"xbrl"},"dep":{"c":"us-gaap:Depreciation","l":"Depreciation","ytd":false,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax","l":"Revenue from Contract with Customer, Including Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","l":"Purchases of fixed assets","ytd":false,"how":"xbrl"}},"co_fcf":null,"co_status":"no_release","co_errors":0,"co_tried":1}},"dims_ytd":{"2026-06-30":{}},"profile":{"cik":1848275,"name":"TOP Financial Group Ltd","tickers":["TOP"],"exchanges":["Nasdaq"],"sic":"6200","industry":"Security & Commodity Brokers, Dealers, Exchanges & Services","sector":"financials","fye":"0331","state":"E9","category":"<br>Emerging growth company"},"periods":{"q":["2025-06-30","2025-09-30","2026-06-30"],"fy":["2020-03-31","2021-03-31","2022-03-31","2023-03-31","2024-03-31","2025-03-31","2026-03-31"]},"intro":{"text":"On July 9, 2025, the Company and ZYNL (BVI) Limited (\u201cZYNL\u201d), a subsidiary of the Company, entered into a Share Purchase Agreement with Zhong Yang Financial Services Limited (the \u201cTarget\u201d) and the sole shareholder of the Target. The sole shareholder is a company incorporated under the laws of Hong Kong, of which a family member of Ms. Junli Yang, the Chairwoman of the Board, and Ms. Yung Yung Lo, the Chief Financial Officer, hold 71.50% and 8.30% equity interests, respectively. Pursuant to the agreement, ZYNL agreed to purchase 100% of the equity interest in the Target for a total purchase price of HKD500,000 (approximately US$63,750). See \u201cItem 13. Certain Relationships and Related Transactions, and Director Independence.\u201d","url":"https://www.sec.gov/Archives/edgar/data/1848275/000121390026075954/ea0297046-10k_top.htm","filed":"2026-07-07","source":"10-K"},"keep":7,"hist":2,"da_v":2,"quality":{"v":7,"unit":"USD","q":[{"end":"2025-06-30","start":"2025-03-31","label":"Q1 FY26","ni":85992,"basis":"ni","ocf":7138236,"assets_open":46799758,"assets_close":null,"wc":{"rev":1333393,"cor":null,"days":91,"ar_o":null,"ar_c":null,"inv_o":null,"inv_c":null,"ap_o":null,"ap_c":null,"ap_proxy":false,"has_inv":false,"dso":null,"dio":null,"dpo":null,"ccc":null},"bridge":{"start":85992,"basis":"pl","items":[["da",7472,[6,"3m",[0]]]],"ocf":7138236,"residual":7044772,"ref":{"start":[5,"3m",[0]],"ocf":[1,"3m",[0]]}},"ev":{"rev":[3,"3m",[0]],"ni":[0,"3m",[0]],"ocf":[1,"3m",[0]],"assets_open":[2,"bal",[1],"2025-03-31"]}},{"end":"2025-09-30","start":"2025-06-30","label":"Q2 FY26","ni":104548,"basis":"ni","ocf":152933,"assets_open":null,"assets_close":64068336,"wc":{"rev":1535542,"cor":null,"days":92,"ar_o":null,"ar_c":8657193,"inv_o":null,"inv_c":null,"ap_o":null,"ap_c":null,"ap_proxy":false,"has_inv":false,"dso":null,"dio":null,"dpo":null,"ccc":null},"bridge":{"start":104548,"basis":"ni","items":[["da",668,[6,"ytd",[2,0]]]],"ocf":152933,"residual":47717,"ref":{"start":[0,"ytd",[2,0]],"ocf":[1,"ytd",[2,0]]}},"ev":{"rev":[3,"ytd",[2,0]],"ar_c":[4,"bal",[2],"2025-09-30"],"ni":[0,"ytd",[2,0]],"ocf":[1,"ytd",[2,0]],"assets_close":[2,"bal",[2],"2025-09-30"]}},{"end":"2026-06-30","start":"2026-03-31","label":"Q1 FY27","ni":-113433,"basis":"ni","ocf":6034786,"assets_open":86056943,"assets_close":158407198,"wc":{"rev":1076700,"cor":null,"days":91,"ar_o":11751771,"ar_c":81182401,"inv_o":null,"inv_c":null,"ap_o":nul