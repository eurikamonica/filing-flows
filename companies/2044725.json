{"quarters":{"2025-09-30":{"end":"2025-09-30","label":"Q3 2025","fq":3,"fy":2025,"cal":"CY2025Q3","form":"10-Q","accn":"0001193125-25-315972","filed":"2025-12-11","doc_url":"https://www.sec.gov/Archives/edgar/data/2044725/000119312525315972/evmn-20250930.htm","index_url":"https://www.sec.gov/Archives/edgar/data/2044725/000119312525315972/0001193125-25-315972-index.htm","raw":{"revenue":10000000,"cor":null,"gp":null,"rd":19639000,"sm":null,"ga":3689000,"sga":null,"costs_total":null,"opex_total":23328000,"oi":-13328000,"pretax":null,"tax":0,"ni":-12475000,"pl":-12475000,"nci":null,"ocf":-9635000,"da":311000,"dep":null,"amort":null,"sbc":560000,"rev_contract":10000000,"capex":131000},"q1_end":"2025-06-30","py_end":"2024-09-30","raw_q1":{"revenue":0,"cor":null,"gp":null,"rd":19638000,"sm":null,"ga":3356000,"sga":null,"costs_total":null,"opex_total":22994000,"oi":-22994000,"pretax":null,"tax":0,"ni":-13565000,"pl":-13565000,"nci":null,"ocf":-26208000,"da":375000,"dep":null,"amort":null,"sbc":556000,"rev_contract":0,"capex":0},"raw_py":{"revenue":null,"cor":null,"gp":null,"rd":13289000,"sm":null,"ga":3228000,"sga":null,"costs_total":null,"opex_total":16517000,"oi":-16517000,"pretax":null,"tax":0,"ni":-15916000,"pl":null,"nci":null,"ocf":null,"da":null,"dep":null,"amort":null,"sbc":401000,"rev_contract":null,"capex":null},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"rd":[{"heading":"Research and Development","text":"The following table summarizes our research and development expenses for each of the periods indicated:\n\nResearch and development expenses were $53.6 million and $46.4 million for the nine months ended September 30, 2025 and 2024, respectively. The increase was primarily attributable to an increase in clinical trial expenses for EVO756 and additional preclinical research expenses for undisclosed discovery programs, which is classified as discovery research expense in the table above, partially offset by a decrease for EVO301, primarily related to our in-licensing which included an upfront license fee payment of $15.0 million, which was expensed as incurred in 2024.\n\nResearch and development expenses were $19.6 million and $13.3 million for the three months ended September 30, 2025 and 2024, respectively. The increase was primarily attributable to an increase in clinical trial expenses for EVO756 and additional preclinical research expenses for undisclosed discovery programs, which is classified as discovery research expense in the table above, partially offset by a decrease for EVO301."}],"ga":[{"heading":"General and Administrative","text":"The following table summarizes our general and administrative expenses for each of the periods indicated:\n\nGeneral and administrative expenses were $10.7 million and $9.1 million for the nine months ended September 30, 2025 and 2024, respectively. The increase was primarily due to an increase in personnel costs due to increased headcount.\n\nGeneral and administrative expenses were $3.7 million and $3.2 million for the three months ended September 30, 2025 and 2024, respectively. The increase was primarily due to an increase in personnel costs and stock-based compensation due to increased headcount."}],"nonop":[{"heading":"Other income, net","text":"Other income, net was $10.8 million and $2.5 million for the nine months ended September 30, 2025 and 2024, respectively. The increase was primarily due to a decrease in the fair value of convertible preferred stock forward of $8.9 million upon settlement of the stock forward in June 2025, offset by a decrease in interest income of $0.6 million.\n\nOther income, net was $0.9 million and $0.6 million for the three months ended September 30, 2025 and 2024, respectively. The increase was primarily due to an increase in interest income of $0.2 million."}],"net":[{"heading":null,"text":"Cash used in operating activities of $59.7 million during the nine months ended September 30, 2025 was attributable to our net loss of $40.6 million, a net decrease of $11.7 million in our working capital, and non-cash income upon settlement of preferred stock forward of $8.9 million, partially offset by non-cash items, including stock-based compensation, accretion of discount on short-term investments and depreciation and amortization expense totaling $1.5 million."}],"ocf":[{"heading":"Operating Activities","text":"Cash used in operating activities of $59.7 million during the nine months ended September 30, 2025 was attributable to our net loss of $40.6 million, a net decrease of $11.7 million in our working capital, and non-cash income upon settlement of preferred stock forward of $8.9 million, partially offset by non-cash items, including stock-based compensation, accretion of discount on short-term investments and depreciation and amortization expense totaling $1.5 million.\n\nCash used in operating activities of $39.7 million during the nine months ended September 30, 2024 was attributable to our net loss of $46.1 million, partially offset by non-cash items, including stock-based compensation, accretion of discount on short-term investments and depreciation and amortization expense totaling $0.8 million, and a net increase of $5.6 million in our working capital."}],"da":[{"heading":null,"text":"Cash used in operating activities of $59.7 million during the nine months ended September 30, 2025 was attributable to our net loss of $40.6 million, a net decrease of $11.7 million in our working capital, and non-cash income upon settlement of preferred stock forward of $8.9 million, partially offset by non-cash items, including stock-based compensation, accretion of discount on short-term investments and depreciation and amortization expense totaling $1.5 million."}],"sbc":[{"heading":null,"text":"Cash used in operating activities of $59.7 million during the nine months ended September 30, 2025 was attributable to our net loss of $40.6 million, a net decrease of $11.7 million in our working capital, and non-cash income upon settlement of preferred stock forward of $8.9 million, partially offset by non-cash items, including stock-based compensation, accretion of discount on short-term investments and depreciation and amortization expense totaling $1.5 million."}],"wc":[{"heading":null,"text":"Cash used in operating activities of $59.7 million during the nine months ended September 30, 2025 was attributable to our net loss of $40.6 million, a net decrease of $11.7 million in our working capital, and non-cash income upon settlement of preferred stock forward of $8.9 million, partially offset by non-cash items, including stock-based compensation, accretion of discount on short-term investments and depreciation and amortization expense totaling $1.5 million."}],"capex":[{"heading":null,"text":"Cash provided by investing activities in the nine months ended September 30, 2025 comprised maturities of short-term investments of $46.5 million, partially offset by purchases of short-term investments of $38.8 million and property and equipment of $0.1 million."}],"net sales":[{"heading":"Revenue","text":"For the nine months ended September 30, 2025 and 2024, we recognized $13.0 million and $7.0 million, respectively, in revenue through our license agreements. The increase was due to higher license revenue recognized under the Maruho Japan Agreement in 2025. License revenue of $3.0 million was recognized upon the satisfaction of the performance obligation and $10.0 million was recognized upon completion of development milestones under the Maruho Japan Agreement for the nine months ended September 30, 2025, compared to $7.0 million recognized under the Maruho Greater Asia Agreement for the nine months ended September 30, 2024.\n\nFor the three months ended September 30, 2025 and 2024, we recognized $10.0 million and $0.0 million, respectively, in revenue through our license agreements. The increase was due to higher license revenue recognized under the Maruho Japan Agreement in 2025. License revenue of $10.0 million was recognized upon completion of development milestones under the Maruho Japan Agreement for the three months ended September 30, 2025, compared to no development milestones achieved during the three months ended September 30, 2024."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Payments to Acquire Property, Plant, and Equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"rd":{"c":"us-gaap:ResearchAndDevelopmentExpense","l":"Research and Development Expense","ytd":false,"how":"xbrl"},"ga":{"c":"us-gaap:GeneralAndAdministrativeExpense","l":"General and Administrative Expense","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating Income (Loss)","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income Tax Expense (Benefit)","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net Income (Loss) Attributable to Parent","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net Income (Loss), Including Portion Attributable to Noncontrolling Interest","ytd":true,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net Cash Provided by (Used in) Operating Activities","ytd":true,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationAndAmortization","l":"Depreciation, Depletion and Amortization, Nonproduction","ytd":true,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":true,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquire