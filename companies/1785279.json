o":{"text":"Metagenomi Therapeutics, Inc. is an in vivo genome editing company capitalizing on its proprietary technologies to create curative genetic medicines for patients. The Company was founded on the science of metagenomics, the study of genetic materials recovered from the natural environment, to discover and develop a suite of novel CRISPR gene-editing tools potentially capable of correcting any type of genetic mutation found anywhere in the human genome. The Company focuses on high value programs in disease indications with well-understood biology and clearly defined clinical development and regulatory pathways. Going forward, the Company intends to continue to expand its pipeline by leveraging its proprietary genetic editing capabilities in site specific deletion, insertion and correction.","url":"https://www.sec.gov/Archives/edgar/data/1785279/000119312526342388/mgx-ex99_1.htm","filed":"2026-08-10","source":"8-K"},"periods":{"q":["2023-03-31","2023-06-30","2023-09-30","2023-12-31","2024-03-31","2024-06-30","2024-09-30","2024-12-31","2025-03-31","2025-06-30","2025-09-30","2025-12-31","2026-03-31"],"fy":["2023-12-31","2024-12-31","2025-12-31"]},"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0000950170-25-040217","filed":"2025-03-17","doc_url":"https://www.sec.gov/Archives/edgar/data/1785279/000095017025040217/mgx-20241231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1785279/000095017025040217/0000950170-25-040217-index.htm","period":"fy","raw":{"revenue":52295000,"cor":null,"gp":null,"rd":109179000,"sm":null,"ga":32017000,"sga":null,"costs_total":null,"opex_total":141196000,"oi":-88901000,"pretax":-83571000,"tax":-5513000,"ni":-78058000,"pl":-78058000,"nci":null,"ocf":-109073000,"da":5407000,"dep":5407000,"amort":null,"sbc":16204000,"rev_contract":52295000,"capex":3114000},"py_end":"2023-12-31","raw_py":{"revenue":44756000,"cor":null,"gp":null,"rd":94403000,"sm":null,"ga":28845000,"sga":null,"costs_to