10-Q","accn":"0001437749-26-016715","filed":"2026-05-13","doc_url":"https://www.sec.gov/Archives/edgar/data/1443575/000143774926016715/avbh20260331_10q.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1443575/000143774926016715/0001437749-26-016715-index.htm","raw":{"revenue":101000,"cor":null,"gp":null,"rd":null,"sm":116000,"ga":null,"sga":null,"costs_total":null,"opex_total":null,"oi":null,"pretax":12440000,"tax":3419000,"ni":9021000,"pl":null,"nci":null,"ocf":8244000,"da":31000,"dep":null,"amort":null,"sbc":837000,"rev_contract":101000,"capex":9000},"q1_end":"2025-12-31","py_end":"2025-03-31","raw_q1":{"revenue":null,"cor":null,"gp":null,"rd":null,"sm":121000,"ga":null,"sga":null,"costs_total":null,"opex_total":null,"oi":null,"pretax":10091000,"tax":3142000,"ni":6949000,"pl":null,"nci":null,"ocf":15952000,"da":null,"dep":null,"amort":null,"sbc":769000,"rev_contract":null,"capex":0},"raw_py":{"revenue":46000,"cor":null,"gp":null,"rd":null,"sm":127000,"ga":null,"sga":null,"costs_total":null,"opex_total":null,"oi":null,"pretax":7681000,"tax":2245000,"ni":5436000,"pl":null,"nci":null,"ocf":4257000,"da":379000,"dep":null,"amort":null,"sbc":820000,"rev_contract":46000,"capex":23000},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"nonop":[{"heading":"Non-interest Expense","text":"Non-interest expense includes salaries and employee benefits, occupancy and equipment, data processing, professional fees, FDIC insurance assessments, legal and professional fees, and other expenses. In evaluating our level of non-interest expense, we closely monitor our efficiency ratio. The efficiency ratio is calculated by dividing non-interest expense by net interest income plus non-interest income. We continue to seek to identify ways to streamline our business and operate more efficiently."}],"tax":[{"heading":"Income Taxes","text":"We monitor and evaluate the potential impact of current events on the estimates used to establish income tax expenses and income tax liabilities. Periodically, we evaluate our income tax positions based on current tax law and positions taken by various tax auditors within the jurisdictions where we are required to file income tax returns.\n\nIncome tax expense was $3.4 million and $2.2 million for the three months ended March 31, 2026 and 2025, respectively. The effective tax rate for the three months ended March 31, 2026 and 2025 was 27.5% and 29.2%, respectively. The decrease compared to the first quarter of 2025 was primarily due to discrete tax benefits related to the vesting of equity awards."}],"net":[{"heading":null,"text":"Net interest income is the most significant contributor to our net income and is the difference between the interest and fees earned on interest-earning assets and the interest expense incurred in connection with interest-bearing liabilities. Net interest income is primarily a function of the average balances and yields of these interest-earning assets and interest-bearing liabilities. These factors are influenced by internal considerations such as product mix and risk appetite as well as external influences such as economic conditions, competition for loans and deposits and market interest rates."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Purchase of premises and equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"sm":{"c":"us-gaap:MarketingAndAdvertisingExpense","l":"Advertising and marketing","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest","l":"us-gaap_Income Loss From Continuing Operations Before Income Taxes Extraordinary Items Noncontrolling Interest","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Provision for income taxes","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net income","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"us-gaap_Net Cash Provided By Used In Operating Activities","ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationDepletionAndAmortization","l":"Depreciation, Depletion and Amortization","ytd":false,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":false,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","l":"Purchase of premises and equipment","ytd":false,"how":"xbrl"}},"co_fcf":null,"co_status":"not_reported","co_errors":0,"co_tried":1}},"dims_ytd":{"2025-06-30":{},"2025-09-30":{"ProductOrServiceAxis":{"avbh:ServiceChargesFeesAndOtherIncomeMember":["Service Charges, Fees And Other Income",2381000.0],"avbh:ForeignExchangeIncomeMember":["Foreign Exchange Income",683000.0],"avbh:OtherNoninterestIncomeMember":["Other Income",566000.0]}},"2026-03-31":{}},"keep":7,"hist":2,"profile":{"cik":1443575,"name":"Avidbank Holdings, Inc.","tickers":["AVBH"],"exchanges":["Nasdaq"],"sic":"6022","industry":"State Commercial Banks","sector":"financials","fye":"1231","state":"CA","category":"<br>Emerging growth company"},"intro":{"text":"We are Avidbank Holdings, a bank holding company based in San Jose, California that operates through our wholly owned subsidiary, Avidbank, a California state-chartered bank (\"Avidbank\" or the \"Bank\"). Founded in 2003, Avidbank is a full-service commercial bank dedicated to providing innovative banking solutions to a diverse client base, including small-to-medium sized businesses, technology companies, and individuals through robust portfolios of lending products, deposit services, and digital banking capabilities. We believe we provide competitive deposit products and treasury management solutions with a high-touch, relationship-driven approach, guided by our commitment to being Responsive, Collaborative & Accountable\u2014principles we embody in every client interaction.","url":"https://www.sec.gov/Archives/edgar/data/1443575/000143774926008852/avbh20251231_10k.htm","filed":"2026-03-18","source":"10-K"},"periods":{"q":["2024-06-30","2024-09-30","2025-03-31","2025-06-30","2025-09-30","2026-03-31"],"fy":[]},"da_v":2}