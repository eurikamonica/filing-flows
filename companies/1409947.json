{"quarters":{"2024-12-31":{"end":"2024-12-31","label":"Q4 2024","fq":4,"fy":2024,"cal":"CY2024Q4","form":"10-K","accn":"0001214659-25-003521","filed":"2025-02-26","doc_url":"https://www.sec.gov/Archives/edgar/data/1409947/000121465925003521/w2525110k.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1409947/000121465925003521/0001214659-25-003521-index.htm","raw":{"revenue":831000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":49000,"sga":null,"costs_total":null,"opex_total":764000,"oi":67000,"pretax":null,"tax":null,"ni":null,"pl":102000,"nci":null,"ocf":509000,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":738000,"capex":null},"q1_end":"2024-09-30","py_end":"2023-12-31","raw_q1":{"revenue":951000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":44000,"sga":null,"costs_total":null,"opex_total":686000,"oi":265000,"pretax":null,"tax":null,"ni":303000,"pl":303000,"nci":null,"ocf":759000,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":858000,"capex":null},"raw_py":{"revenue":1254000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":36000,"sga":null,"costs_total":null,"opex_total":852000,"oi":402000,"pretax":null,"tax":null,"ni":null,"pl":null,"nci":null,"ocf":780000,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":1210000,"capex":null},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"opex":[{"heading":null,"text":"Operating Expenses. Operating expenses represent costs specifically identifiable or allocable to the Fund\u2019s wells, as detailed in the following table."}],"costs":[{"heading":null,"text":"Operating Expenses. Operating expenses represent costs specifically identifiable or allocable to the Fund\u2019s wells, as detailed in the following table."}],"ga":[{"heading":null,"text":"General and Administrative Expenses. General and administrative expenses represent costs specifically identifiable or allocable to the Fund, such as accounting and professional fees and insurance expenses."}],"tax":[{"heading":"Income Taxes","text":"No provision is made for income taxes in the financial statements. The Fund is a limited liability company, and as such, the Fund\u2019s income or loss is passed through and included in the tax returns of the Fund\u2019s shareholders. The Fund files U.S. Federal and State tax returns and the 2021 through 2023 tax returns remain open for examination by tax authorities."}],"ocf":[{"heading":null,"text":"Cash flows provided by operating activities during the year ended December 31, 2024 were $2.9 million, primarily related to revenue received of $4.0 million and interest income received of $0.1 million, partially offset by operating expenses of $0.5 million, management fees of $0.5 million and general and administrative expenses of $0.2 million."}],"capex":[{"heading":"Capital Expenditures","text":"The Fund has entered into multiple agreements for the acquisition, drilling and development of its oil and gas properties. The estimated capital expenditures associated with these agreements vary depending on the stage of development on a property-by-property basis.\n\nCapital expenditures for oil and gas properties have been funded with the capital raised by the Fund in its private placement offering and through debt financing. The Fund\u2019s capital has been fully invested and as a result, the Fund will not invest in any new projects and will limit its investment activities, if any, to those projects in which it currently has a working interest. Such investment activities, which include estimated capital spending on planned well recompletions for the Beta Project, are expected to be funded from cash flows from operations and existing cash-on-hand and not from equity, debt or off-balance sheet financing arrangements.\n\nSee Item 1. \u201cBusiness\u201d of this Annual Report under the heading \u201cProperties\u201d and \u201cLiquidity Needs\u201d below for additional information."}],"net sales":[{"heading":"Revenue Recognition","text":"Oil and gas revenues from contracts with customers are recognized at the point when control of oil and natural gas is transferred to the customers in accordance with Accounting Standard Codification Topic 606, Revenue from Contracts with Customers (\u201cASC 606\u201d) . The Fund\u2019s revenue recognition policies, performance obligations and significant judgments in applying ASC 606 are described below."}]},"capex_src":null,"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":true,"how":"xbrl"},"ga":{"c":"us-gaap:GeneralAndAdministrativeExpense","l":"General and administrative expenses","ytd":true,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":true,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating Income (Loss)","ytd":true,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net Income (Loss), Including Portion Attributable to Noncontrolling Interest","ytd":true,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net Cash Provided by (Used in) Operating Activities","ytd":true,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax","l":"Revenue from Contract with Customer, Including Assessed Tax","ytd":true,"how":"xbrl"}},"co_fcf":null,"co_status":"no_release","co_errors":0,"co_tried":1},"2025-03-31":{"end":"2025-03-31","label":"Q1 2025","fq":1,"fy":2025,"cal":"CY2025Q1","form":"10-Q","accn":"0001214659-25-006944","filed":"2025-05-05","doc_url":"https://www.sec.gov/Archives/edgar/data/1409947/000121465925006944/w41125010q.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1409947/000121465925006944/0001214659-25-006944-index.htm","raw":{"revenue":796000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":54000,"sga":null,"costs_total":null,"opex_total":668000,"oi":128000,"pretax":null,"tax":null,"ni":null,"pl":159000,"nci":null,"ocf":494000,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":699000,"capex":null},"q1_end":"2024-12-31","py_end":"20