2011-01-31","2011-04-30","2011-07-31","2011-10-31","2012-01-31","2012-04-30","2012-07-31","2012-10-31","2013-01-31","2013-04-30","2013-07-31","2013-10-31","2014-01-31","2014-04-30","2014-07-31","2014-10-31","2015-01-31","2015-04-30","2015-07-31","2015-10-31","2016-01-31","2016-04-30","2016-07-31","2016-10-31","2017-01-31","2017-04-30","2017-07-31","2017-10-31","2018-01-31","2018-03-31","2018-04-30","2018-06-30","2018-07-31","2018-09-30","2018-10-31","2019-03-31","2019-06-30","2019-09-30","2019-12-31","2020-03-31","2020-06-30","2020-09-30","2020-12-31","2021-03-31","2021-06-30","2021-09-30","2021-12-31","2022-03-31","2022-06-30","2022-09-30","2022-12-31","2023-03-31","2023-06-30","2023-09-30","2023-12-31","2024-03-31","2024-06-30","2024-09-30","2024-12-31","2025-03-31","2025-06-30","2025-09-30","2025-12-31","2026-03-31","2026-06-30"],"fy":["2009-10-31","2010-10-31","2011-10-31","2012-10-31","2013-10-31","2014-10-31","2015-10-31","2016-10-31","2017-10-31","2018-10-31","2019-12-31","2020-12-31","2021-12-31","2022-12-31","2023-12-31","2024-12-31","2025-12-31"]},"intro":{"text":"The Invesco CurrencyShares \u00ae Australian Dollar Trust (the \u201cTrust\u201d) is a grantor trust that was formed on June 8, 2006. The Shares began trading on the New York Stock Exchange under the ticker symbol \u201cFXA\u201d on June 26, 2006. The primary listing of the Shares was transferred to NYSE Arca, Inc. (\u201cNYSE Arca\u201d) on October 30, 2007. The Trust issues shares (the \u201cShares\u201d) in blocks of 50,000 (a \u201cBasket\u201d) in exchange for deposits of Australian Dollars and distributes Australian Dollars in connection with the redemption of Baskets. The investment objective of the Trust is for the Shares to reflect the price in USD of the Australian Dollar plus accrued interest, if any, less the expenses of the Trust\u2019s operations. The Shares are intended to offer investors an opportunity to participate in the market for the Australian Dollar through an investment in securities.","url":"https://www.sec.gov/Archives/edgar/data/1353614/000119312526083544/fxa-20251231.htm","filed":"2026-03-02","source":"10-K"},"keep":7,"hist":2,"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0000950170-25-027258","filed":"2025-02-26","doc_url":"https://www.sec.gov/Archives/edgar/data/1353614/000095017025027258/fxa-20241231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1353614/000095017025027258/0000950170-25-027258-index.htm","period":"fy","raw":{"revenue":1356538,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":277952,"oi":null,"pretax":null,"tax":0,"ni":1078586,"pl":null,"nci":null,"ocf":1102559,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":null,"capex":null},"py_end":"2023-12-31","raw_py":{"revenue":1086795,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":290525,"oi":null,"pretax":null,"tax":0,"ni":796270,"pl":null,"nci":null,"ocf":727127,"da":null,"dep":null,"amort":null,"sbc":null,"rev_contract":null,"capex":null},"capex_src":null,"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income Tax Expense (Benefit)","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net Income (Loss) Attributable to Parent","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net Cash Provided by (Used in) Operating Activities","ytd":false,"how":"xbrl"}},"lines_struct":null,"lines":null,"lines_py":null,"notes":{}},"2025-12-31":{"end":"2025-12-31","label":"FY2025","fy":2025,"form":"10-K","accn":"0001193125-26-083544","filed":"2026-03-02","doc_url":"https://www.sec.gov/Archives/edgar/data/1353614/000119312526083544/fxa-20251231.htm","index_url":"https://www.sec.gov/Archives/edgar/d