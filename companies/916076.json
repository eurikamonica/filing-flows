":365000000,"tax":73000000,"ni":328000000,"pl":328000000,"nci":0,"ocf":387000000,"da":167000000,"dep":null,"amort":null,"sbc":6000000,"rev_contract":1609000000,"capex":179000000},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"gp":[{"heading":null,"text":"The following tables present revenues and gross profit (loss) for the Company and its reportable segments by product line for the three months ended June 30, 2026 and 2025."}],"ga":[{"heading":"Selling, General and Administrative Expenses","text":"Consolidated SG&A for the six months ended June 30 was 7.5% of revenues in 2026 compared with 8.3% in the prior-year period as revenue growth outpaced the increase in these expenses."}],"sga":[{"heading":"Selling, General and Administrative Expenses (SG&A)","text":"Consolidated SG&A for the second quarter of 2026 was 5.9% of revenues compared with 6.5% in the prior-year quarter as revenue growth outpaced the increase in these expenses."}],"tax":[{"heading":"Income Taxes","text":"For the six months ended June 30, 2026 and 2025, the effective income tax rates for continuing operations were 23.3% and 20.3%, respectively. The higher 2026 effective income tax rate compared with 2025 was primarily attributable to the revaluation of deferred tax liabilities driven by changes in the state jurisdictional mix of the business following the QUIKRETE transaction."}],"ocf":[{"heading":"Cash Provided by Operating Activities","text":"Cash provided by operating activities for the six months ended June 30, 2026 and 2025 was $339 million and $605 million, respectively. Operating cash flow is substantially derived from consolidated net earnings before deducting depreciation, depletion and amortization and the impact of changes in working capital requirements. In the six months ended June 30, 2026, operating cash flow reflects the deduction of the noncash gain on the QUIKRETE transaction from net earnings and the higher income tax payments related to the gain on the QUIKRETE transaction.\n\nThe seasonal nature of construction activity impacts the Company\u2019s interim operating cash flow when compared with the full year. Full-year 2025 net cash provided by operating activities was $1.8 billion."}],"da":[{"heading":null,"text":"The following table displays depreciation, depletion and amortization by product line included in the Costs of revenues line item in the consolidated statements of earnings and comprehensive earnings."}],"capex":[{"heading":null,"text":"Cash on hand, along with the Company\u2019s projected internal cash flows and availability of financing resources, including its access to debt and equity capital markets, is expected to remain sufficient to provide the capital resources necessary to support anticipated operating needs, cover debt service requirements, meet capital expenditures and discretionary investment needs, fund certain acquisition opportunities that may arise, allow for payment of dividends for the foreseeable future and allow the repurchase of shares of the Company\u2019s common stock. At June 30, 2026, the Company had $742 million of unused borrowing capacity under its Revolving Facility and Trade Receivable Facility, subject to complying with the related leverage covenant. Historically, the Company has successfully extended the maturity dates of these credit facilities."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Payments to Acquire Property, Plant, and Equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfGoodsAndServicesSold","l":"Cost of Goods and Services Sold","ytd":false,"how":"xbrl"},"gp":{"c":"us-gaap:GrossProfit","l":"Gross Profit","ytd":false,"how":"xbrl"},"sga":{"c":"us-gaap:SellingGeneralAndAdministrativeExpense","l":"Selling, General and Administrative Expense","ytd":false,"how":"xbr