      "title": "First Amendment To First Amended And Restated Credit Agreement",
      "facility": "revolving",
      "benchmarks": [
        "Term SOFR",
        "Daily Simple SOFR",
        "SOFR",
        "Base Rate"
      ],
      "covenants": [
        {
          "type": "net_worth",
          "limit": 310504331.0,
          "unit": "usd",
          "direction": "min",
          "maintenance": true,
          "text": "The Borrower will not at any time permit Consolidated Tangible Net Worth to be less than the sum of (i) $310,504,331.00, plus (ii) seventy-five percent (75.0%) of the sum of any additional Net Offering Proceeds after the date of this Agreement. | §9.5 | Liquidity | ."
        },
        {
          "type": "liquidity",
          "limit": 5000000.0,
          "unit": "usd",
          "direction": "min",
          "maintenance": false,
          "text": "The Borrower shall have Liquidity at all times of not less than Five Million and No/100 Dollars ($5,000,000.00). 118 US_ACTIVE\\121755035\\V-6 | §9.6 | Unhedged Variable Rate Debt | ."
        },
        {
          "type": "net_worth",
          "limit": 500000000.0,
          "unit": "usd",
          "direction": "min",
          "maintenance": false,
          "text": "Upon any such resignation, the Required Lenders, subject to the terms of §18.1, shall have the right to appoint as a successor Agent and, if applicable, Issuing Lender and Swing Loan Lender, any Lender or any bank whose senior debt obligations are rated not less than “A” or its equivalent by Moody’s or not less than “A” or its equivalent by S&P and which has a net worth of not less than $500,000,000.00."
        }
      ]
    }
