          "limit": 2.0,
          "unit": "x",
          "direction": "min",
          "maintenance": true,
          "text": "The Company will not permit its Fixed Charge Coverage Ratio, determined as at the end of each fiscal quarter of the Company, to be less than 2.00 to 1."
        },
        {
          "type": "net_worth",
          "limit": 505790400.0,
          "unit": "usd",
          "direction": "min",
          "maintenance": true,
          "text": "The Company will not permit its Adjusted Net Worth, determined as of the end of each fiscal quarter of the Company, to be less than the sum of (i) $505,790,400, plus (ii) an amount equal to 50% of the consolidated net income of the Company and its Subsidiaries (with no deduction for any quarterly loss) in each fiscal quarter ending on or after December 31, 2006. -46- Section 6.10 Investments."
        },
        {
          "type": "leverage",
          "limit": 3.25,
          "unit": "x",
          "direction": "max",
          "maintenance": false,
