venue":782600000,"cor":236600000,"gp":null,"rd":null,"sm":null,"ga":null,"sga":109500000,"costs_total":430400000,"opex_total":null,"oi":352200000,"pretax":308500000,"tax":74300000,"ni":234200000,"pl":234200000,"nci":null,"ocf":390400000,"da":69900000,"dep":null,"amort":14400000,"sbc":18400000,"rev_contract":782600000,"capex":64000000},"raw_py":{"revenue":772600000,"cor":229500000,"gp":null,"rd":null,"sm":null,"ga":null,"sga":106500000,"costs_total":418300000,"opex_total":null,"oi":354300000,"pretax":327900000,"tax":74600000,"ni":253300000,"pl":253300000,"nci":0,"ocf":244500000,"da":66000000,"dep":null,"amort":16300000,"sbc":14100000,"rev_contract":772600000,"capex":55800000},"lines_struct":null,"lines":null,"lines_q1":null,"lines_py":null,"notes":{"nonop":[{"heading":null,"text":"EBITDA, Adjusted EBITDA, and Adjusted EBITDA Expenses: EBITDA represents GAAP net income adjusted for (i) depreciation and amortization of fixed assets; (ii) amortization of intangible assets; (iii) interest expense, net; and (iv) provision for income taxes. Adjusted EBITDA represents EBITDA adjusted for acquisition-related adjustments (earn-outs), gain/loss from dispositions (which includes businesses held for sale), net adjustments from equity-method investments, and nonrecurring gain/loss. Adjusted EBITDA expenses represent adjusted EBITDA net of revenues. We believe these measures are useful and meaningful because they help us allocate resources, make business decisions, allow for greater transparency regarding our operating performance, and facilitate period-to-period comparison."}],"tax":[{"heading":null,"text":"EBITDA, Adjusted EBITDA, and Adjusted EBITDA Expenses: EBITDA represents GAAP net income adjusted for (i) depreciation and amortization of fixed assets; (ii) amortization of intangible assets; (iii) interest expense, net; and (iv) provision for income taxes. Adjusted EBITDA represents EBITDA adjusted for acquisition-related adjustments (earn-outs), gain/loss from dispositions (which includes businesses held for sale), net adjustments from equity-method investments, and nonrecurring gain/loss. Adjusted EBITDA expenses represent adjusted EBITDA net of revenues. We believe these measures are useful and meaningful because they help us allocate resources, make business decisions, allow for greater transparency regarding our operating performance, and facilitate period-to-period comparison."}],"net":[{"heading":null,"text":"EBITDA, Adjusted EBITDA, and Adjusted EBITDA Expenses: EBITDA represents GAAP net income adjusted for (i) depreciation and amortization of fixed assets; (ii) amortization of intangible assets; (iii) interest expense, net; and (iv) provision for income taxes. Adjusted EBITDA represents EBITDA adjusted for acquisition-related adjustments (earn-outs), gain/loss from dispositions (which includes businesses held for sale), net adjustments from equity-method investments, and nonrecurring gain/loss. Adjusted EBITDA expenses represent adjusted EBITDA net of revenues. We believe these measures are useful and meaningful because they help us allocate resources, make business decisions, allow for greater transparency regarding our operating performance, and facilitate period-to-period comparison."}],"ocf":[{"heading":null,"text":"Free Cash Flow: Free cash flow represents net cash provided by operating activities determined in accordance with GAAP minus payments for capital expenditures. We believe free cash flow is an important measure of the recurring cash generated by our operations that may be available to repay debt obligations, repurchase our stock, invest in future growth through new business development activities, or make acquisitions."}],"da":[{"heading":null,"text":"EBITDA, Adjusted EBITDA, and Adjusted EBITDA Expenses: EBITDA represents GAAP net income adjusted for (i) depreciation and amortization of fixed assets; (ii) amortization of intangible assets; (iii) interest expense, net; and (iv) provision for income taxes. Adjusted EBITDA represents EBITDA adjusted for acquisition-related adjustments (earn-outs), gain/loss from dispositions (which includes businesses held for sale), net adjustments from equity-method investments, and nonrecurring gain/loss. Adjusted EBITDA expenses represent adjusted EBITDA net of revenues. We believe these measures are useful and meaningful because they help us allocate resources, make business decisions, allow for greater transparency regarding our operating performance, and facilitate period-to-period comparison."}],"capex":[{"heading":null,"text":"Free Cash Flow: Free cash flow represents net cash provided by operating activities determined in accordance with GAAP minus payments for capital expenditures. We believe free cash flow is an important measure of the recurring cash generated by our operations that may be available to repay debt obligations, repurchase our stock, invest in future growth through new business development activities, or make acquisitions."}],"fcf":[{"heading":null,"text":"Summary of Results (GAAP and Non-GAAP) ($ in millions, except per share amounts) Note: Adjusted EBITDA, diluted adjusted EPS, and free cash flow are non-GAAP measures."}],"net sales":[{"heading":null,"text":"\"Our solid second-quarter financial performance reflects the durability of Verisk\u2019s economic model and the operational discipline with which we are managing the business. Our strong underlying subscription revenues are a demonstration of the essential role we play in helping insurance industry participants make better decisions across underwriting and claims and the deep client relationships and connection we have within the industry. We continue to invest in our proprietary datasets, and deploy advanced AI technologies across these unmatched data assets, in order to deliver innovative and distinctive insights that deepen client value and support future growth. These investments, combined with our operational discipline, position us well to deliver sustainable long-term value for clients and shareholders.\""}]},"capex_src":{"label":"capital expenditures","how":"release"},"src":{"revenue":{"l":"Revenues","how":"release"},"sga":{"l":"Selling, general and administrative","how":"release"},"oi":{"l":"Operating income","how":"release"},"pretax":{"l":"Income before income taxes","how":"release"},"tax":{"l":"Provision for income taxes","how":"release"},"pl":{"l":"Net income","how":"release"},"da":{"l":"Depreciation and amortization of fixed assets","how":"release"},"sbc":{"l":"Stock-based compensation expense","how":"release"},"ocf":{"l":"Net cash provided by operating activities","how":"release"},"capex":{"l":"Capital expenditures","how":"release"}},"co_fcf":null,"co_status":"unmatched","co_errors":0,"co_tried":1}},"dims_ytd":{"2024-12-31":{"StatementBusinessSegmentsAxis":{"vrsk:InsuranceMember":["Insurance",2881700000.0],"vrsk:FinancialServicesMember":["Financial Services",0.0]},"ProductOrServiceAxis":{"vrsk:SpecializedMarketsMember":["Specialized Markets",0.0]}},"2025-03-31":{},"2025-06-30":{},"2025-09-30":{},"2025-12-31":{},"2026-03-31":{}},"keep":7,"hist":2,"profile":{"cik":1442145,"name":"Verisk Analytics, Inc.","tickers":["VRSK"],"exchanges":["Nasdaq"],"sic":"7374","industry":"Services-Computer Processing & Data Preparation","sector":"technology","fye":"1231","state":"DE","category":"Large accelerated filer"},"periods":{"q":["2010-03-31","2010-06-30","2010-09-30","2010-12-31","2011-03-31","2011-06-30","2011-09-30","2011-12-31","2012-03-31","2012-06-30","2012-09-30","2012-12-31","2013-03-31","2013-06-30","2013-09-30","2013-12-31","2014-03-31","2014-06-30","2014-09-30","2014-12-31","2015-03-31","2015-06-30","2015-09-30","2015-12-31","2016-03-31","2016-06-30","2016-09-30","2016-12-31","2017-03-31","2017-06-30","2017-09-30","2017-12-31","2018-03-31","2018-06-30","2018-09-30","2018-12-31","2019-03-31","2019-06-30","2019-09-30","2019-12-31","2020-03-31","2020-06-30","2020-09-30","2020-12-31","2021-03-31","2021-06-20","2