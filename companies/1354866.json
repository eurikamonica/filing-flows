    "0001437749-26-003206:ex_916443.htm": {
      "kind": "agreement",
      "date": "2026-02-05",
      "agreement_kind": "credit_agreement",
      "dated": "2026-02-03",
      "facility": "revolving",
      "benchmarks": [
        "Term SOFR",
        "SOFR"
      ],
      "margin_pct": [
        0.25,
        2.75
      ],
      "margin_text": " (a) from the Closing Date to the date on which the Lender receives a Compliance Certificate pursuant to Section 7.1 of this Agreement for the fiscal quarter ending May 31, 2026, 2.50% per annum, and (b) thereafter, the applicable percentage per annum set forth below determined by reference to the Leverage Ratio as set forth in the most recent Compliance Certificate received by the Lender pursuant to Section 7.1 of this Agreement: Pricing Level | Leverage Ratio | Applicable Margin | Unused Commitment Fee | 1 | Less than 1.00 | 2.50% | 0.25% | 2 | Greater than or equal to 1.00 | 2.75% | 0.25% |",
      "grid_by": "leverage",
      "maturity": "2031-02-03",
      "covenants": [
        {
          "type": "leverage",
          "limit": 1.5,
          "unit": "x",
          "direction": "max",
          "maintenance": true,
          "text": "Borrower shall not permit as of the last day of any fiscal quarter the ratio of all Debt of Borrower and its Subsidiaries, on a consolidated basis, as of such date, to EBITDA, for Borrower and its Subsidiaries (the “Leverage Ratio”), on a consolidated basis, for the Test Period ending on the last day of such fiscal quarter, to be greater than 1.50 to 1.00;"
        },
        {
          "type": "fixed_charge",
          "limit": 1.25,
          "unit": "x",
          "direction": "min",
          "maintenance": true,
          "text": "Borrower shall not permit, as of the last day of any fiscal quarter, the Fixed Charge Coverage Ratio, in each case for Borrower and its Subsidiaries, on a consolidated basis, for the Test Period ending on the last day of such fiscal quarter, to be less than 1.25 to 1.00."
        },
        {
          "type": "leverage",
          "limit": 1.25,
          "unit": "x",
          "direction": "max",
          "maintenance": false,
          "text": "After giving effect to such Delayed Draw Term Loan, Borrower shall provide a pro forma Compliance Certificate to Lender demonstrating a Leverage Ratio of not greater than 1.25 to 1.00;"
        }
      ]
    },
