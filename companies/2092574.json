rom Continuing Operations before Income Taxes, Noncontrolling Interest","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income Tax Expense (Benefit)","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net Income (Loss) Attributable to Parent","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net Income (Loss), Including Portion Attributable to Noncontrolling Interest","ytd":true,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net Cash Provided by (Used in) Operating Activities","ytd":true,"how":"xbrl"},"da":{"c":"us-gaap:Depreciation","l":"Depreciation","ytd":true,"how":"xbrl"},"dep":{"c":"us-gaap:Depreciation","l":"Depreciation","ytd":true,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":true,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","l":"Payments to Acquire Property, Plant, and Equipment","ytd":true,"how":"xbrl"}},"co_fcf":null,"co_status":"not_reported","co_errors":0,"co_tried":1}},"dims_ytd":{"2026-03-31":{},"2026-06-30":{}},"profile":{"cik":2092574,"name":"Swarmer, Inc","tickers":["SWMR"],"exchanges":["Nasdaq"],"sic":"7372","industry":"Services-Prepackaged Software","sector":"technology","fye":"1231","state":"DE","category":"Non-accelerated filer<br>Smaller reporting company<br>Emerging growth company"},"periods":{"q":["2025-03-31","2025-06-30","2026-03-31","2026-06-30"],"fy":["2024-12-31","2025-12-31"]},"keep":7,"hist":2,"intro":{"text":"Swarmer\u2122 is a defense technology company that specializes in vendor-agnostic software which allows one operator to intuitively control hundreds of autonomous platforms in real time. Swarmer\u2019s primary mission areas include autonomous swarm coordination, integration of multi-domain unmanned systems and AI-powered autonomy software for distributed operations. Swarmer is not a drone manufacturer and does not depend on any single platform, supplier or hardware lifecycle. Instead, Swarmer operates at the intelligence layer, developing autonomy, coordination and decision-making software that enables large numbers of low-cost unmanned systems to operate collectively as one coherent, resilient force. Swarmer\u2019s technology has been rigorously validated in real-world kinetic environments and was first deployed in combat operations in Ukraine in April 2024.","url":"https://www.sec.gov/Archives/edgar/data/2092574/000119312526349241/swmr-ex99_1.htm","filed":"2026-08-13","source":"8-K"},"da_v":2}