":384595,"rev_contract":12003,"capex":11324},"q1_end":"2024-12-31","py_end":"2024-03-31","raw_q1":{"revenue":5408,"cor":5926,"gp":-518,"rd":1593515,"sm":251052,"ga":913495,"sga":null,"costs_total":null,"opex_total":2758062,"oi":-2758580,"pretax":null,"tax":null,"ni":-2595774,"pl":null,"nci":null,"ocf":-2549873,"da":90109,"dep":null,"amort":54350,"sbc":432446,"rev_contract":5408,"capex":3805},"raw_py":{"revenue":78739,"cor":68498,"gp":10241,"rd":1366893,"sm":316611,"ga":853688,"sga":null,"costs_total":null,"opex_total":2537192,"oi":-2526951,"pretax":null,"tax":null,"ni":-2469626,"pl":null,"nci":null,"ocf":-1875295,"da":81121,"dep":null,"amort":52697,"sbc":381019,"rev_contract":78739,"capex":29611},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"cor":[{"heading":null,"text":"Cost of Revenue. Cost of commercial revenue was $30,862 for the three months ended March 31, 2025, compared to $68,498 for the three months ended March 31, 2024. For the three months ended March 31, 2025, our cost of revenue included cost of product sales and development expenses related to our first design win. For the three months ended March 31, 2024, our cost of revenue related to the completion of the second phase of our development agreement with Stellantis."}],"rd":[{"heading":null,"text":"Research and Development Expenses. Research and development expenses increased by $201,099, or 15%, to $1,567,992 in the three months ended March 31, 2025 from $1,366,893 in the three months ended March 31, 2024. The increase was due to higher personnel costs of $160,005 and semiconductor fabrication costs of $51,288, partly offset by lower other B-TRAN\u00ae development spending of $10,194. We expect higher quarterly research and development expenses in the remainder of 2025 as compared to the first quarter of 2025 as we continue development of our B-TRAN\u00ae technology. There will also be quarter-to-quarterly variability to research and development expenses due to the timing of semiconductor fabrication runs and other development activities."}],"sm":[{"heading":null,"text":"Sales and Marketing Expenses. Sales and marketing expenses increased by $21,549, or 7%, to $338,160 in the three months ended March 31, 2025 from $316,611 in the three months ended March 31, 2024. The increase was due to higher personnel costs of $35,896, partly offset by lower stock-based compensation expense of $13,768 and other spending of $579. We expect higher quarterly sales and marketing expenses in the remainder of 2025 as compared to the first quarter of 2025 as we further commercialize our B-TRAN\u00ae technology."}],"ga":[{"heading":null,"text":"General and Administrative Expenses. General and administrative expenses increased by $46,133, or 5%, to $899,821 in the three months ended March 31, 2025 from $853,688 in the three months ended March 31, 2024. The increase was due to higher personnel costs of $57,394, stock-based compensation expense of $14,076 and other spending of $18,746, partly offset by lower investor relations spending of $44,083. We expect slightly to modestly higher quarterly general and administrative expenses, exclusive of stock-based compensation, in the remainder of 2025 as compared to the first quarter of 2025."}],"net":[{"heading":null,"text":"Net Loss. Our net loss for the three months ended March 31, 2025 was $2,703,024, or 9% higher, as compared to a net loss of $2,469,626 for the three months ended March 31, 2024, for the reasons discussed above."}],"ocf":[{"heading":null,"text":"Operating activities in the three months ended March 31, 2025 resulted in cash outflows of $2,066,774 which were due to the net loss for the period of $2,703,024, partly offset by stock-based compensation of $384,595, favorable balance sheet timing of $139,102 and other non-cash items of $112,553."}],"sbc":[{"heading":null,"text":"Operating activities in the three months ended March 31, 2025 resulted in cash outflows of $2,066,774 which were due to the net loss for the period of $2,703,024, partly offset by stock-based compensation of $384,595, favorable balance sheet timing of $139,102 and other non-cash items of $112,553."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Purchase of property and equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax","l":"Revenue from Contract with Customer, Including Assessed Tax","ytd":false,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfRevenue","l":"Cost of revenue","ytd":false,"how":"xbrl"},"gp":{"c":"us-gaap:GrossProfit","l":"us-gaap_Gross Profit","ytd":false,"how":"xbrl"},"rd":{"c":"us-gaap:ResearchAndDevelopmentExpense","l":"Research and development","ytd":false,"how":"xbrl"},"sm":{"c":"us-gaap:SellingAndMarketingExpense","l":"Sales and marketing","ytd":false,"how":"xbrl"},"ga":{"c":"us-gaap:GeneralAndAdministrativeExpense","l":"General and administrative","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"us-gaap_Operating Expenses","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"us-gaap_Operating Income Loss","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net loss","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"us-gaap_Net Cash Provided By Used In Operating Activities","ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationDepletionAndAmortization","l":"Depreciation, Depletion and Amortization","ytd":false,"how":"xbrl"},"amort":{"c":"us-gaap:AmortizationOfIntangibleAssets","l":"Amortization of Intangible Assets","ytd":false,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":false,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax","l":"Revenue from Contract with Customer, Including Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndE