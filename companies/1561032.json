          "limit": 35000000.0,
          "unit": "usd",
          "direction": "min",
          "maintenance": true,
          "text": "Prior to the consummation of a Qualified IPO, the Parent shall not permit Liquidity to be less than $35,000,000 as of the last day of any fiscal quarter."
