 actions. The FTSE Developed ex US Index is a rules-based, float-adjusted, market capitalization-weighted index comprised of large- and mid-capitalization stocks providing coverage of the developed markets in twenty-four non-U.S. countries. The FTSE Developed ex US Index is derived from the FTSE Global Equity Index Series, which covers 98% of the worlds investable market capitalization.","risks":[],"risk_narrative":null},"ncen":{"series":"S000052001","name":"Pacer International Export Leaders ETF","lei":"549300YL1JB9VF3R0U90","acc":"0000894189-26-021136","filed":"2026-07-14","period":"2026-04-30","cik":1616668,"index":true,"index_affiliated":false,"index_exclusive":false,"multi_inverse":false,"fund_of_funds":false,"non_diversified":true,"track_diff_gross":-1.587482,"track_diff":-2.250776,"track_err_gross":7.9434,"track_err":7.943315,"lends":false,"lending_ok":false,"avg_on_loan":null,"lending_income":null,"expense_cap":false,"fees_waived":false,"commissions":70.0,"principal_trades":0.0,"avg_net_assets":868845.0,"mgmt_fee":null,"net_expenses":null,"price":null,"nav":null,"derivatives_rule":false,"line_of_credit":false,"registrant":{"name":"Pacer Funds Trust","file_num":"811-23024","lei":"549300L3D3N0PW0L9M73","family":"","type":"N-1A","state":"US-PA","material_weakness":false,"accountant_changed":false,"legal_proceeding":false},"accountant":["Sanville & Company"],"distributor":[["Pacer Financial, Inc.",true]],"board":[["Joe M. Thomson",true],["Jane K. Sagendorph",false],["Deborah G. Wolk",false],["Colin C. Lake",false]],"cco":["Liam Clarke"],"etf":{"creation_unit":20000.0,"cash_in":7.0,"cash_out":0.0,"fee_in":1000.0,"fee_out":1000.0,"in_kind":true,"collateral":false,"track_diff":null,"track_err":null},"advisers":[["Pacer Advisors, Inc.","Advisor","000137382",false,"22-DEC-2025"]],"custodians":[["U.S. Bank National Association",false,false,"Bank - section 17(f)(1) (15 U.S.C. 80a-17(f)(1))","US"]],"administrators":[["U.S. Bancorp Fund Services, LLC",false]],"transfer_a