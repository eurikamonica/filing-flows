3-12-31","2024-12-31","2025-12-31"]},"intro":{"text":"The LGL Group, Inc. (\"LGL,\" \"LGL Group,\" or the \"Company\") is a holding company engaged in services, merchant investment and manufacturing business activities. Precise Time and Frequency, LLC (\"PTF\") is a globally positioned producer of industrial Electronic Instruments and commercial products and services. Founded in 2002, PTF operates from our design and manufacturing facility in Wakefield, Massachusetts. Lynch Capital International LLC is focused on the development of value through investments. LGL Group was incorporated in 1928 under the laws of the State of Indiana, and in 2007, the Company was reincorporated under the laws of the State of Delaware as The LGL Group, Inc. We maintain our executive offices at 2525 Shader Road, Orlando, Florida 32804. Our telephone number is (202) 780-5941. Our Internet address is www.lglgroup.com.","url":"https://www.sec.gov/Archives/edgar/data/61004/000143774926028019/ex_966790.htm","filed":"2026-08-14","source":"8-K"},"keep":7,"hist":2,"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001437749-25-010246","filed":"2025-03-31","doc_url":"https://www.sec.gov/Archives/edgar/data/61004/000143774925010246/lglg20241231_10k.htm","index_url":"https://www.sec.gov/Archives/edgar/data/61004/000143774925010246/0001437749-25-010246-index.htm","period":"fy","raw":{"revenue":4292000,"cor":null,"gp":null,"rd":null,"sm":185000,"ga":null,"sga":null,"costs_total":3593000,"opex_total":null,"oi":699000,"pretax":699000,"tax":177000,"ni":432000,"pl":522000,"nci":90000,"ocf":874000,"da":21000,"dep":0,"amort":21000,"sbc":36000,"rev_contract":2226000,"capex":0.0},"py_end":"2023-12-31","raw_py":{"revenue":3678000,"cor":null,"gp":null,"rd":null,"sm":11000,"ga":null,"sga":null,"costs_total":3032000,"opex_total":null,"oi":646000,"pretax":646000,"tax":301000,"ni":269000,"pl":317000,"nci":48000,"ocf":385000,"da":22000,"dep":1000,"amort":21000,"sbc":3000,"re