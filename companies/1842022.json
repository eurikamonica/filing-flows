    "0000947871-24-001003:ss4232708_ex1001.htm": {
      "kind": "agreement",
      "date": "2024-12-12",
      "agreement_kind": "amendment",
      "dated": "2024-12-12",
      "title": "To Credit Agreement",
      "facility": "revolving",
      "benchmarks": [
        "Term SOFR",
        "Daily Simple SOFR",
        "SOFR",
        "Base Rate"
      ],
      "margin_pct": [
        2.0,
        2.0
      ],
      "margin_text": ": (a) prior to the occurrence of an Investment Grade Event, for any day with respect to (i) any Term SOFR Loan (A) that is an Initial Term Loan, 2.00% per annum and (B) that is an Initial Revolving Loan, the rate per annum set forth in the Revolver Pricing Grid under the caption “Leverage-Based Pricing Grid” for Term SOFR Loans based upon the Consolidated Net Leverage Ratio and (ii) any ABR Loan (A) that is an Initial Term Loan, 1.00% per annum and (B) that is an Initial Revolving Loan, the rate per annum set forth in the Revolver Pricing Grid under the caption “Leverage-Based Pricing Grid” fo",
      "grid_by": "ratings",
      "fee_pct": 1.125,
      "floor_pct": 0.5,
      "covenants": [
        {
          "type": "leverage",
          "limit": 5.5,
          "unit": "x",
          "direction": "max",
          "maintenance": true,
          "text": "(b) Beginning with the fiscal quarter ending on September 30, 2021, at any time while the Initial Revolving Facility is in effect, the Borrower will not permit the Consolidated Net Leverage Ratio for the Test Period ending as of the end of such fiscal quarter and each fiscal quarter thereafter to be greater than, (i) at any time during a Specified Acquisition Period, 5.50 to 1.00 and (ii) at any other time, 5.00:1.00"
        },
        {
          "type": "interest_coverage",
          "limit": 2.5,
          "unit": "x",
          "direction": "min",
          "maintenance": true,
          "text": "(c) Beginning with the fiscal quarter ending on September 30, 2021, at any time prior to the occurrence of an Investment Grade Event while the Initial Revolving Facility is in effect, the Borrower will not permit the Interest Coverage Ratio for the Test Period ending as of the end of such fiscal quarter and each fiscal quarter thereafter to be less than 2.50 to 1.00."
        },
        {
          "type": "leverage",
          "limit": 5.25,
          "unit": "x",
          "direction": "max",
          "maintenance": false,
          "text": "following the election of a Specified Acquisition Period, no Specified Acquisition Period may immediately follow another Specified Acquisition Period unless, as of the last day of the latest fiscal quarter ending on or prior to the Final Test Date of the first such Specified Acquisition Period, the Consolidated Net Leverage Ratio does not exceed 5.25 to 1.00."
        },
        {
          "type": "leverage",
          "limit": 3.5,
          "unit": "x",
          "direction": "min",
          "maintenance": false,
          "text": "of the Equity Interests or Property of such Unrestricted Subsidiary) except to the extent such Investment has been re-categorized under another exception to this Section 6.04 in accordance with Section 1.05 ; (r) other Investments not otherwise permitted pursuant to this Section 6.04 so long as the First Lien Net Leverage Ratio is less than 3.50:1.00 on a Pro Forma Basis;"
        }
      ]
    },
