lated products. Our offerings empower investors to shape their financial future and equip financial professionals to grow their businesses. Leveraging the latest financial infrastructure, we create products that emphasize access and transparency and provide an enhanced user experience. Building on our heritage of innovation, we offer next-generation digital products and services related to tokenized real world assets and stablecoins, as well as our institutional platform, WisdomTree Connect \u2122 and blockchain-native digital wallet, WisdomTree Prime \u00ae* , and have expanded into private markets through the acquisition of Ceres Partners\u2019 U.S. farmland platform.","url":"https://www.sec.gov/Archives/edgar/data/880631/000121465926009324/ex99_1.htm","filed":"2026-07-31","source":"8-K"},"keep":7,"hist":2,"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001214659-25-003503","filed":"2025-02-26","doc_url":"https://www.sec.gov/Archives/edgar/data/880631/000121465925003503/wt-20241231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/880631/000121465925003503/0001214659-25-003503-index.htm","period":"fy","raw":{"revenue":427737000,"cor":null,"gp":null,"rd":null,"sm":20532000,"ga":83963000,"sga":null,"costs_total":null,"opex_total":290444000,"oi":137293000,"pretax":95402000,"tax":28709000,"ni":66693000,"pl":null,"nci":null,"ocf":113461000,"da":1752000,"dep":null,"amort":null,"sbc":20691000,"rev_contract":427737000,"capex":141000},"py_end":"2023-12-31","raw_py":{"revenue":349035000,"cor":null,"gp":null,"rd":null,"sm":17256000,"ga":71348000,"sga":null,"costs_total":null,"opex_total":261543000,"oi":87492000,"pretax":119008000,"tax":16462000,"ni":102546000,"pl":null,"nci":null,"ocf":85600000,"da":872000,"dep":null,"amort":null,"sbc":16190000,"rev_contract":349035000,"capex":113000},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Purchase of fixed assets","how":"xbrl"},"src":{"revenue"