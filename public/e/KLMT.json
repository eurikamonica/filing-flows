 at least a 6% average reduction per year in greenhouse gas (GHG) emissions related to a companys enterprise value including cash, taking into account Scope 1 and 2 emissions relative to the GHG Intensity of the Parent Index. Scope 1 emissions are direct GHG emissions that occur from sources that are controlled or owned by an organization. Scope 2 emissions are indirect GHG emissions generated in the production of electricity consumed by the organization. GHG Intensity measures a companys Scope 1 and 2 emissions relative to its enterprise value including cash. ? at least a 20% increase, relative to the Parent Index, in the aggregate weight of companies having one or more active carbon emissions reduction target(s) approved by the SBTi, starting from December 2021. Please Retain This Supplement for Future Reference.","risks":[],"risk_narrative":null},"ncen":{"series":"S000085579","name":"Invesco MSCI Global Climate 500 ETF","lei":"2549002DZ8BLMM2PR441","acc":"0001378872-26-000052","filed":"2026-01-14","period":"2025-10-31","cik":1378872,"index":true,"index_affiliated":false,"index_exclusive":false,"multi_inverse":false,"fund_of_funds":false,"non_diversified":true,"track_diff_gross":0.340775,"track_diff":0.229391,"track_err_gross":4.897957,"track_err":4.897957,"lends":true,"lending_ok":true,"avg_on_loan":20685649.658333,"lending_income":82227.0,"expense_cap":true,"fees_waived":true,"commissions":119956.21,"principal_trades":666688914.73,"avg_net_assets":1390702522.46,"mgmt_fee":null,"net_expenses":null,"price":null,"nav":null,"derivatives_rule":false,"line_of_credit":false,"registrant":{"name":"Invesco Exchange-Traded Fund Trust II","file_num":"811-21977","lei":"O540V2L4S174Y60FMD36","family":"INVESCOETF","type":"N-1A","state":"US-IL","material_weakness":false,"accountant_changed":false,"legal_proceeding":false},"accountant":["PricewaterhouseCoopers LLP"],"distributor":[["Invesco Distributors, Inc.",true]],"board":[["Brian Hartigan",true],["Donald H. Wilson",false],["