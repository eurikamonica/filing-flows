eveloping Gedeptin\u00ae, a gene-directed enzyme prodrug therapy (GDEPT) designed to enhance immune checkpoint inhibitor activity.","url":"https://www.sec.gov/Archives/edgar/data/832489/000143774926024522/ex_993355.htm","filed":"2026-07-27","source":"8-K"},"periods":{"q":["2017-03-31","2017-06-30","2017-09-30","2017-12-31","2018-03-31","2018-06-30","2018-09-30","2018-12-31","2019-03-31","2019-06-30","2019-09-30","2019-12-31","2020-03-31","2020-06-30","2020-09-30","2020-12-31","2021-03-31","2021-06-30","2021-09-30","2021-12-31","2022-03-31","2022-06-30","2022-09-30","2022-12-31","2023-03-31","2023-06-30","2023-09-30","2023-12-31","2024-03-31","2024-06-30","2024-09-30","2024-12-31","2025-03-31","2025-06-30","2025-09-30","2025-12-31","2026-03-31","2026-06-30"],"fy":["2016-12-31","2017-12-31","2018-12-31","2019-12-31","2020-12-31","2021-12-31","2022-12-31","2023-12-31","2024-12-31","2025-12-31"]},"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001437749-25-009614","filed":"2025-03-27","doc_url":"https://www.sec.gov/Archives/edgar/data/832489/000143774925009614/govx20241231_10k.htm","index_url":"https://www.sec.gov/Archives/edgar/data/832489/000143774925009614/0001437749-25-009614-index.htm","period":"fy","raw":{"revenue":3954576,"cor":null,"gp":null,"rd":23713602,"sm":null,"ga":5385254,"sga":null,"costs_total":null,"opex_total":29098856,"oi":-25144280,"pretax":null,"tax":null,"ni":-24992296,"pl":null,"nci":null,"ocf":-24675511,"da":95368,"dep":80368,"amort":null,"sbc":528644,"rev_contract":3954576,"capex":20653},"py_end":"2023-12-31","raw_py":{"revenue":0,"cor":null,"gp":null,"rd":20720766,"sm":null,"ga":6022173,"sga":null,"costs_total":null,"opex_total":26742939,"oi":-26742939,"pretax":null,"tax":null,"ni":-25966762,"pl":null,"nci":null,"ocf":-25173639,"da":74169,"dep":null,"amort":null,"sbc":1074957,"rev_contract":0,"capex":48946},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Purchase o