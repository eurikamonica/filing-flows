dgar/data/60667/000006066726000029/low-20260130.htm","index_url":"https://www.sec.gov/Archives/edgar/data/60667/000006066726000029/0000060667-26-000029-index.htm","raw":{"revenue":20585000000,"cor":13904000000,"gp":6681000000,"rd":null,"sm":null,"ga":null,"sga":4410000000,"costs_total":null,"opex_total":null,"oi":1708000000,"pretax":1304000000,"tax":304000000,"ni":1000000000,"pl":null,"nci":null,"ocf":1567000000,"da":637000000,"dep":null,"amort":null,"sbc":70000000,"rev_contract":20585000000,"capex":603000000},"q1_end":"2025-10-31","py_end":"2025-01-31","raw_q1":{"revenue":20813000000,"cor":13697000000,"gp":7116000000,"rd":null,"sm":null,"ga":null,"sga":4160000000,"costs_total":null,"opex_total":null,"oi":2481000000,"pretax":2129000000,"tax":513000000,"ni":1616000000,"pl":null,"nci":null,"ocf":687000000,"da":535000000,"dep":null,"amort":null,"sbc":60000000,"rev_contract":20813000000,"capex":597000000},"raw_py":{"revenue":18554000000,"cor":12457000000,"gp":6097000000,"rd":null,"sm":null,"ga":null,"sga":3822000000,"costs_total":null,"opex_total":null,"oi":1830000000,"pretax":1502000000,"tax":378000000,"ni":1124000000,"pl":null,"nci":null,"ocf":911000000,"da":511000000,"dep":null,"amort":null,"sbc":57000000,"rev_contract":18554000000,"capex":548000000},"lines_struct":{"leaves":[{"id":"us-gaap:ProductMember","label":"Products"},{"id":"us-gaap:ServiceMember","label":"Services"},{"id":"us-gaap:ProductAndServiceOtherMember","label":"Other"}],"groups":[],"axis":"ProductOrServiceAxis"},"lines":{"us-gaap:ProductMember":19535000000.0,"us-gaap:ServiceMember":589000000.0,"us-gaap:ProductAndServiceOtherMember":461000000.0},"lines_py":null,"notes":{"gp":[{"heading":null,"text":"Gross Margin \u2013 Gross margin as a percentage of sales for fiscal 2025 increased 16 basis points compared to fiscal 2024. The gross margin increase for the year was primarily driven by favorability from credit revenue and improvements in inventory shrink, partially offset by the operational cost structure of acquisitions during 2025."}],"tax":[{"heading":null,"text":"1 Income tax adjustment is defined as net operating profit multiplied by the effective tax rate, which was 23.9% , 24.0% , and 24.1% for fiscal 2025 , fiscal 2024 , and fiscal 2023 , respectively."}],"ocf":[{"heading":"Cash Flows Provided by Operating Activities","text":"Cash flows from operating activities continued to provide the primary source of our liquidity. The increase in net cash provided by operating activities for the year ended January 30, 2026, compared to the year ended January 31, 2025, was primarily driven by changes in merchandise inventory due to inventory optimization efforts during the year, partially offset by lower net earnings and the timing of income tax payments which were previously deferred under the income tax relief announced by the IRS for businesses impacted by Hurricane Helene."}],"da":[{"heading":null,"text":"Depreciation and Amortization \u2013 Depreciation and amortization expense deleveraged 18 basis points for fiscal 2025 as a percentage of sales compared to fiscal 2024, primarily due to amortization of intangible assets of acquired businesses in 2025."}],"capex":[{"heading":"Capital expenditures","text":"Our capital expenditures generally consist of investments in our strategic initiatives to enhance our ability to serve customers, improve existing stores, and support expansion plans. Capital expenditures were $2.2 billion in fiscal 2025 and $1.9 billion in fiscal 2024.\n\nFor fiscal 2026, our guidance for capital expenditures is approximately $2.5 billion. We may adjust our capital expenditures, if necessary or appropriate, to support our operations, to enhance long-term strategic positioning, or in response to the economic environment."}],"Products":[{"heading":null,"text":"In addition, we receive funds from vendors in the normal course of business, principally as a result of purchase volumes, early payments, or sales-based promotions of vendors\u2019 products. Generally, these vendor funds do not represent the reimbursement of specific, incremental, and identifiable costs that we incurred to sell the vendor\u2019s product. The majority of the vendor funds associated with these purchases are earned under agreements that are negotiated on an annual basis or shorter. The funds are recorded as a reduction to the cost of inventory as they are earned. As the related inventory is sold, the amounts are recorded as a reduction to cost of sales. Funds that are determined to be reimbursements of specific, incremental, and identifiable costs incurred to sell vendors\u2019 products are recorded as an offset to the related expense."}],"Services":[{"heading":null,"text":"During 2025, we continued to drive progress across all five key initiatives of our Total Home strategy, which was reflected in the strength we delivered with our Pro customers, online, and home services. Our Total Home strategic initiatives have appealed to both the value-conscious homeowner and the busy Pro customer."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Capital expenditures","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Net sales","ytd":true,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfGoodsAndServicesSold","l":"Cost of sales","ytd":true,"how":"xbrl"},"gp":{"c":"us-gaap:GrossProfit","l":"Gross Profit","ytd":true,"how":"xbrl"},"sga":{"c":"us-gaap:SellingGeneralAndAdministrativeExpense","l":"Selling, General and Administrative Expense","ytd":true,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating income","ytd":true,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest","l":"Pre-tax earnings","ytd":true,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income tax provision","ytd":true,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net earnings","ytd":true,"how