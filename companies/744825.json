      "dated": "2021-04-09",
      "size": 5500000.0,
      "title": "Confidential Third Amendment To Credit Agreement",
      "facility": "revolving",
      "benchmarks": [
        "Daily Simple SOFR",
        "SOFR",
        "Base Rate",
        "Prime Rate"
      ],
      "margin_pct": [
        0.25,
        3.0
      ],
      "margin_text": ": (a) with respect to any Tranche Rate Loan, three percent (3.0%) per annum; (b) subject to Section 2.5(b) or (c) of the Agreement, with respect to any Base Rate Loan, two percent (2.0%) per annum; and (c) with respect to the Unused Line Fee, one-quarter of one percent (00.25%) per annum. “ASHS ” has the meaning given to such term in the preamble to the Agreement. ",
      "covenants": [
        {
          "type": "fixed_charge",
          "limit": 1.25,
          "unit": "x",
          "direction": "min",
          "maintenance": true,
          "text": "Borrowers shall not permit report to the Lender whether the Fixed Charge Coverage Ratio, as of the end of any Fiscal Quarter, commencing with the Fiscal Quarter ending June 30, 2021, to be was or was not less than or equal to 1.25 to 1.00 for the period of four consecutive Fiscal Quarters ending on such date."
        },
        {
          "type": "fixed_charge",
          "limit": 1.25,
          "unit": "x",
          "direction": "min",
          "maintenance": false,
          "text": "nts in an aggregate amount of at least $5,000,000, for the Fiscal Quarter ending December 31, 2025, March 31, 2026, and June 30, 2026; (C) the Financial Covenant set forth in Section 6.1 of the Existing Credit Agreement and Section 1(a) of Annex III thereto requiring the Borrowers to not permit the Fixed Charge Coverage Ratio to be less than or equal to 1.25 to 1.00 for the period of four consecutive Fiscal Quarters"
        },
        {
          "type": "fixed_charge",
          "limit": 1.25,
          "unit": "x",
          "direction": "max",
          "maintenance": false,
          "text": "While no Event of Default shall arise hereunder if the Fixed Charge Coverage Ratio is less than the level stated in the preceding sentence, any basket or threshold contained in this Agreement dependent on compliance with a Former Financial Covenant may only be satisfied if the Fixed Charge Coverage Ratio would have been greater than or equal to 1.25 to 1.00 after giving pro forma effect to the relevant transaction."
        }
      ]
    },
