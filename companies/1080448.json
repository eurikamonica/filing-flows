{"quarters":{"2026-06-30":{"end":"2026-06-30","label":"Q2 2026","fq":2,"fy":2026,"cal":"CY2026Q2","form":"10-Q","accn":"0001683168-26-006416","filed":"2026-08-14","doc_url":"https://www.sec.gov/Archives/edgar/data/1080448/000168316826006416/patriot_i10q-063026.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1080448/000168316826006416/0001683168-26-006416-index.htm","raw":{"revenue":1777840,"cor":null,"gp":null,"rd":null,"sm":null,"ga":379447,"sga":null,"costs_total":null,"opex_total":463169,"oi":1314671,"pretax":null,"tax":null,"ni":1284517,"pl":1284517,"nci":null,"ocf":393392,"da":null,"dep":null,"amort":null,"sbc":0,"rev_contract":null,"capex":null},"q1_end":"2026-03-31","py_end":"2025-06-30","raw_q1":{"revenue":0,"cor":null,"gp":null,"rd":null,"sm":null,"ga":215339,"sga":null,"costs_total":null,"opex_total":297257,"oi":-297257,"pretax":null,"tax":null,"ni":-273021,"pl":-273021,"nci":null,"ocf":-168399,"da":null,"dep":null,"amort":null,"sbc":0,"rev_contract":null,"capex":null},"raw_py":{"revenue":0,"cor":null,"gp":null,"rd":null,"sm":null,"ga":471715,"sga":null,"costs_total":null,"opex_total":572266,"oi":-572266,"pretax":null,"tax":null,"ni":-574930,"pl":-574930,"nci":null,"ocf":-161547,"da":null,"dep":null,"amort":null,"sbc":0,"rev_contract":null,"capex":null},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"ga":[{"heading":null,"text":"For the three months ended June 30, 2026 and 2025, general and administrative expenses were $379,447 and $471,715, respectively. For the six months ended June 30, 2026 and 2025, general and administrative expenses were $594,786 and $761,242, respectively. The decrease in 2026 is primarily due to a decrease in legal fees."}],"nonop":[{"heading":null,"text":"For the three months ended June 30, 2026 and 2025, other income (expenses) were ($30,154) and ($2,664), respectively. For the six months ended June 30, 2026 and 2025, other income (expenses) were ($5,918) and $10,722, respectively. The change in other income/expense is due to an approximate $37,000 increase in interest expense, a $5,000 decrease in unrealized gains on marketable securities, offset by a $26,000 increase in currency exchange."}],"net":[{"heading":null,"text":"Net income for the three months ended June 30, 2026 was $1,284,517 compared to net loss of ($574,930) for the three months ended June 30, 2025. Net income for the six months ended June 30, 2026 was $1,011,496 compared to net loss of ($975,036) for the six months ended June 30, 2025. The change in profitability is primarily due to the approximate $1,778,000 increase in royalty revenue, a decrease of $166,000 in general and administrative expenses and a $44,000 decrease in consulting expenses."}],"sbc":[{"heading":"Stock-Based Compensation","text":"We account for equity-based transactions with nonemployees awards in accordance with the Accounting Standards Update (ASU) 2018-07, Compensation\u2014Stock Compensation (Topic 718): ASU 2018-07 establishes that equity-based payment transactions with nonemployees shall be measured at the fair value of the consideration received or the fair value of the equity instruments issued, whichever is more reliably measurable. The fair value of common stock issued for payments to nonemployees is measured at the market price on the date of grant. The fair value of equity instruments, other than common stock, is estimated using the Black-Scholes option valuation model. In general, we recognize the fair value of the equity instruments issued as deferred stock compensation and amortize the cost over the term of the contract.\n\nWe account for employee stock-based compensation in accordance with the guidance of FASB ASC Topic 718, Compensation\u2014Stock Compensation, which requires all share-based payments to employees, including grants of employee stock options, to be recognized in the financial statements based on their fair values."}],"net sales":[{"heading":"Revenue Recognition","text":"On June 1, 2018, the Company adopted Financial Accounting Standards Board (\u201cFASB\u201d) Accounting Standards Codification Topic 606, Revenue from Contracts with Customers (\u201cASC 606\u201d), which provides a single comprehensive model for entities to use in accounting for revenue arising from contracts with customers. The Company receives a royalty of 3% of net smelter returns on the Moss Mine (see Note 3) and recognizes revenue at the time minerals are produced and sold at the Moss Mine. The Company\u2019s revenue recognition policy standards include the following elements under ASU 606:"}]},"capex_src":null,"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"ga":{"c":"us-gaap:GeneralAndAdministrativeExpense","l":"General and administrative","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating Income (Loss)","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net Income (Loss)","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net income (loss)","ytd":true,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation","ytd":true,"how":"xbrl"},"sbc":{"c":"us-gaap:AllocatedShareBasedCompensationExpense","l":"Share-based Payment Arrangement, Expense","ytd":true,"how":"xbrl"}},"co_fcf":null,"co_status":"no_release","co_errors":0,"co_tried":1}},"dims_ytd":{"2026-06-30":{}},"profile":{"cik":1080448,"name":"PATRIOT GOLD CORP","tickers":["PGOL"],"exchanges":["OTC"],"sic":"1040","industry":"Gold and Silver Ores","sector":"materials","fye":"1231","state":"NV","category":"Non-accelerated filer<br>Smaller reporting company"},"periods":{"q":["2010-11-30","2011-02-28","2011-05-31","2011-11-30","2012-02-29","2012-05-31","2018-09-30","2019-03-31","2019-06-30","2019-09-30","2019-12-31","2020-03-31","2020-06-30","2020-09-30","202