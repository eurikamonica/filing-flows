integration of multi-domain unmanned systems and AI-powered autonomy software for distributed operations. Swarmer is not a drone manufacturer and does not depend on any single platform, supplier or hardware lifecycle. Instead, Swarmer operates at the intelligence layer, developing autonomy, coordination and decision-making software that enables large numbers of low-cost unmanned systems to operate collectively as one coherent, resilient force. Swarmer\u2019s technology has been rigorously validated in real-world kinetic environments and was first deployed in combat operations in Ukraine in April 2024.","url":"https://www.sec.gov/Archives/edgar/data/2092574/000119312526349241/swmr-ex99_1.htm","filed":"2026-08-13","source":"8-K"},"da_v":2,"quality":{"v":7,"unit":"USD","q":[{"end":"2025-03-31","start":"2024-12-31","label":"Q1 2025","ni":-693977,"basis":"pl","ocf":-681797,"assets_open":2147903,"assets_close":null,"wc":{"rev":110704,"cor":45542,"days":90,"ar_o":null,"ar_c":null,"inv_o":null,"inv_c":null,"ap_o":null,"ap_c":null,"ap_proxy":false,"has_inv":false,"dso":null,"dio":null,"dpo":null,"ccc":null},"bridge":{"start":-693977,"basis":"pl","items":[["sbc",10233,[6,"3m",[0]]],["d_ap",40890,[7,"3m",[0]]],["d_accr",6570,[8,"3m",[0]]],["d_contract",14737,[9,"3m",[0]]],["d_casset",-34269,[10,"3m",[0]]],["d_oassets",-23036,[11,"3m",[0]]]],"ocf":-681797,"residual":-2945,"ref":{"start":[0,"3m",[0]],"ocf":[1,"3m",[0]]}},"ev":{"rev":[3,"3m",[0]],"cor":[4,"3m",[0]],"ni":[0,"3m",[0]],"ocf":[1,"3m",[0]],"assets_open":[2,"bal",[1],"2024-12-31"]}},{"end":"2025-06-30","start":"2025-03-31","label":"Q2 2025","ni":-1627182,"basis":"pl","ocf":-749703,"assets_open":null,"assets_close":null,"wc":{"rev":138206,"cor":56176,"days":91,"ar_o":null,"ar_c":null,"inv_o":null,"inv_c":null,"ap_o":null,"ap_c":null,"ap_proxy":false,"has_inv":false,"dso":null,"dio":null,"dpo":null,"ccc":null},"bridge":{"start":-1627182,"basis":"pl","items":[["sbc",18255,[6,"ytd",[1,0]]],["d_ap",-41311,[7,"ytd",[1,0]]],[