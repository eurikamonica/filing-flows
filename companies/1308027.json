atural Rubber Latex (\u201cNRL\u201d) currently being used primarily in toppers and in various bedding products. In addition, Vystar had a majority ownership in Murida Furniture Co., Inc. dba Rotmans Furniture (\u201cRotmans\u201d), formerly one of the largest independent furniture retailers in the U.S.","url":"https://www.sec.gov/Archives/edgar/data/1308027/000149315226037720/form10-q.htm","filed":"2026-08-13","source":"10-Q"},"keep":7,"hist":2,"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001641172-25-003946","filed":"2025-04-14","doc_url":"https://www.sec.gov/Archives/edgar/data/1308027/000164117225003946/form10-k.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1308027/000164117225003946/0001641172-25-003946-index.htm","period":"fy","raw":{"revenue":135969,"cor":66328,"gp":69641,"rd":null,"sm":1000,"ga":null,"sga":null,"costs_total":null,"opex_total":1587220,"oi":-1517579,"pretax":-1672067,"tax":null,"ni":759513,"pl":2520312,"nci":1760799,"ocf":-99962,"da":74506,"dep":42790,"amort":31716,"sbc":893138,"rev_contract":135969,"capex":null},"py_end":"2023-12-31","raw_py":{"revenue":525883,"cor":141300,"gp":384583,"rd":100000,"sm":16000,"ga":null,"sga":null,"costs_total":null,"opex_total":1924552,"oi":-1539969,"pretax":null,"tax":null,"ni":-5243870,"pl":-8319395,"nci":-3075525,"ocf":-442662,"da":74883,"dep":62169,"amort":31716,"sbc":886980,"rev_contract":525883,"capex":null},"capex_src":null,"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfRevenue","l":"Cost of revenue","ytd":false,"how":"xbrl"},"gp":{"c":"us-gaap:GrossProfit","l":"Gross Profit","ytd":false,"how":"xbrl"},"sm":{"c":"us-gaap:MarketingAndAdvertisingExpense","l":"Advertising expense","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":false,"how":"xbr