 a leading developer of low-power system-on-a-chip, or SoC, semiconductors and software for edge and physical artificial intelligence, or AI, applications and intelligent automation. The Company's technologies make electronic systems smarter, enabling them to become partially or fully autonomous with features such as intelligent automation, complex scene understanding, and autonomous decision-making. These systems perform multi-modal data fusion and complex data analysis in real time, delivering high quality imagery, and preserving vital system resources such as power and network bandwidth. The Company specializes in the development of deployable, scalable designs for intelligent electronic systems that utilize high-bandwidth sensors offering a proven path to mass production.","url":"https://www.sec.gov/Archives/edgar/data/1280263/000119312526253198/amba-20260430.htm","filed":"2026-06-02","source":"10-Q"},"years":{"2025-01-31":{"end":"2025-01-31","label":"FY25","fy":2025,"form":"10-K","accn":"0000950170-25-046499","filed":"2025-03-28","doc_url":"https://www.sec.gov/Archives/edgar/data/1280263/000095017025046499/amba-20250131.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1280263/000095017025046499/0000950170-25-046499-index.htm","period":"fy","raw":{"revenue":284865000,"cor":112535000,"gp":172330000,"rd":226109000,"sm":null,"ga":null,"sga":72816000,"costs_total":null,"opex_total":298925000,"oi":-126595000,"pretax":-117728000,"tax":-602000,"ni":-117100000,"pl":null,"nci":null,"ocf":33836000,"da":26060000,"sbc":107803000,"capex":10381000},"py_end":"2024-01-31","raw_py":{"revenue":226474000,"cor":89657000,"gp":136817000,"rd":215052000,"sm":null,"ga":null,"sga":76325000,"costs_total":null,"opex_total":291377000,"oi":-154560000,"pretax":-148530000,"tax":20887000,"ni":-169400000,"pl":null,"nci":null,"ocf":19024000,"da":24813000,"sbc":111316000,"capex":11977000},"capex_src":{"concept":"us-gaap:PaymentsToAcquireProductiveAssets","label":"Payments to Acquire Produ