 segments provide a broad range of value-added solutions, which provides our customers with a seamless, end\u2011to\u2011end logistics network designed to reduce complexity and improve speed, reliability and efficiency across the entire flow of goods. Ryder connects every link in the supply chain, moving products smoothly from ports and suppliers all the way to customers\u2019 doorsteps as illustrated below.","url":"https://www.sec.gov/Archives/edgar/data/85961/000008596126000007/r-20251231.htm","filed":"2026-02-11","source":"10-K"},"keep":7,"hist":2,"da_v":2,"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0000085961-25-000032","filed":"2025-02-12","doc_url":"https://www.sec.gov/Archives/edgar/data/85961/000008596125000032/r-20241231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/85961/000008596125000032/0000085961-25-000032-index.htm","period":"fy","raw":{"revenue":12636000000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":1478000000,"costs_total":null,"opex_total":null,"oi":null,"pretax":661000000,"tax":172000000,"ni":489000000,"pl":null,"nci":null,"ocf":2265000000,"da":2228000000,"dep":1694000000,"amort":53000000,"sbc":42000000,"rev_contract":null,"capex":2683000000},"py_end":"2023-12-31","raw_py":{"revenue":11783000000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":1421000000,"costs_total":null,"opex_total":null,"oi":null,"pretax":618000000,"tax":212000000,"ni":406000000,"pl":null,"nci":null,"ocf":2353000000,"da":2085000000,"dep":1712000000,"amort":35000000,"sbc":44000000,"rev_contract":null,"capex":3234000000},"capex_src":{"concept":"us-gaap:PaymentsToAcquireProductiveAssets","label":"Purchases of property and revenue earning equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"sga":{"c":"us-gaap:SellingGeneralAndAdministrativeExpense","l":"Selling, General and Administrative Expense","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:I