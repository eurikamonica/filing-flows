","l":"Share-based Payment Arrangement, Noncash Expense","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","l":"Purchase of property and equipment","ytd":false,"how":"xbrl"}},"co_fcf":null,"co_status":"not_reported","co_errors":0,"co_tried":1}},"dims_ytd":{"2024-12-31":{},"2025-03-31":{}},"keep":7,"hist":2,"profile":{"cik":1638097,"name":"Entera Bio Ltd.","tickers":["ENTX"],"exchanges":["Nasdaq"],"sic":"2836","industry":"Biological Products, (No Diagnostic Substances)","sector":"health","fye":"1231","state":"L3","category":"Non-accelerated filer<br>Smaller reporting company"},"intro":{"text":"Entera is a clinical stage company focused on developing oral peptide and protein replacement therapies for significant unmet medical needs where an oral tablet form holds the potential to transform the standard of care. The Company leverages a disruptive and proprietary technology platform (N-Tab\u00ae) and its pipeline of first-in-class oral peptide programs. The Company\u2019s most advanced product candidate, EB613 (oral PTH(1-34)), is being developed as the first oral, osteoanabolic (bone building) once-daily tablet for osteoporosis. A placebo-controlled, dose-ranging Phase 2 study of EB613 tablets (n = 161) met primary (PD/bone turnover biomarker) and secondary endpoints (BMD).","url":"https://www.sec.gov/Archives/edgar/data/1638097/000117891326003946/exhibit_99-1.htm","filed":"2026-08-07","source":"8-K"},"periods":{"q":["2021-03-31","2021-06-30","2021-09-30","2021-12-31","2022-03-31","2022-06-30","2022-09-30","2022-12-31","2023-03-31","2023-06-30","2023-09-30","2023-12-31","2024-03-31","2024-06-30","2024-09-30","2024-12-31","2025-03-31","2025-06-30","2025-09-30","2025-12-31","2026-03-31","2026-06-30"],"fy":["2020-12-31","2021-12-31","2022-12-31","2023-12-31","2024-12-31","2025-12-31"]},"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001178913-25-001112","filed":"2025-03-28","doc_url":"ht