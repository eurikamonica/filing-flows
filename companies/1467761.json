:{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation","ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationAndAmortization","l":"Depreciation, Depletion and Amortization, Nonproduction","ytd":false,"how":"xbrl"},"amort":{"c":"us-gaap:AmortizationOfIntangibleAssets","l":"Amortization of Intangible Assets","ytd":false,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":false,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","l":"Purchase of property, equipment and software","ytd":false,"how":"xbrl"}},"lines_struct":null,"lines":null,"lines_py":null,"notes":{}}},"intro":{"text":"FiEE, Inc. (NASDAQ:FIEE), formerly Minim, Inc., was founded in 1977. The Company has a historical track record of delivering comprehensive WiFi/Software as a Service platform in the market. After years of development, FiEE made the strategic decision to transition to a Software First Model in 2024 to expand its technology portfolio and revenue streams. In 2025, FiEE rebranded itself as a technology company leveraging its expertise in IoT, connectivity, and AI to explore new business prospects and extend its global footprint. FiEE\u2019s services are structured into four key categories: Cloud-Managed Connectivity (WiFi) Platform, IoT Hardware Sales & Licensing, SaaS Solutions, and Professional To-C and To-B Services & Support.","url":"https://www.sec.gov/Archives/edgar/data/1467761/000182912626008888/fiee_ex99-1.htm","filed":"2026-08-14","source":"8-K"},"da_v":2}