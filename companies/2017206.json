e":"1231","state":"MD","category":"Non-accelerated filer"},"periods":{"q":["2025-03-31","2025-06-30","2025-09-30","2025-12-31","2026-03-31","2026-06-30"],"fy":["2025-12-31"]},"intro":{"text":"Millrose Properties, Inc. is a corporation incorporated under the laws of the State of Maryland on March 19, 2024 and later spun-off by Lennar. The Spin-Off was completed on February 7, 2025, at which time we became an independent, publicly traded company and our Class A common stock was listed on the New York Stock Exchange under the symbol \u201cMRP\u201d. Millrose purchases and develops residential land and sells finished homesites to homebuilders by way of option contracts with predetermined costs and takedown schedules. We serve as a solution for homebuilders seeking to expand access to finished homesites while implementing an asset-light strategy. Our option contracts provide for the payment of recurring cash option fees as compensation for the capital and operational solution delivered by the Millrose platform.","url":"https://www.sec.gov/Archives/edgar/data/2017206/000201720626000002/ck0002017206-20251231.htm","filed":"2026-03-02","source":"10-K"},"keep":7,"hist":2,"years":{"2025-12-31":{"end":"2025-12-31","label":"FY2025","fy":2025,"form":"10-K","accn":"0002017206-26-000002","filed":"2026-03-02","doc_url":"https://www.sec.gov/Archives/edgar/data/2017206/000201720626000002/ck0002017206-20251231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/2017206/000201720626000002/0002017206-26-000002-index.htm","period":"fy","raw":{"revenue":600461000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":25000000,"costs_total":null,"opex_total":114393000,"oi":486068000,"pretax":400373000,"tax":20509000,"ni":379864000,"pl":379864000,"nci":null,"ocf":3672821000,"da":null,"dep":null,"amort":null,"sbc":677000,"rev_contract":null,"capex":null},"py_end":null,"raw_py":null,"capex_src":null,"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"sga"