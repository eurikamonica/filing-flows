ts, including unrefunded tariffs. On May 1, 2025, the Company contributed its SGK Business to a newly-formed entity, Propelis, in exchange for a 40% ownership interest in Propelis and other consideration."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Capital expenditures","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax","l":"Revenue from Contract with Customer, Including Assessed Tax","ytd":false,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfRevenue","l":"Cost of sales","ytd":false,"how":"xbrl"},"gp":{"c":"us-gaap:GrossProfit","l":"Gross profit","ytd":false,"how":"xbrl"},"sm":{"c":"us-gaap:SellingExpense","l":"Selling expense","ytd":false,"how":"xbrl"},"ga":{"c":"us-gaap:GeneralAndAdministrativeExpense","l":"Administrative expense","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating loss","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest","l":"Income before income tax","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income tax provision","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net Income (Loss) Attributable to Parent","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net income (loss)","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation","ytd":true,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationDepletionAndAmortization","l":"Depreciation, Depletion and Amortization","ytd":false,"how":"xbrl"},"amort":{"c":"us-gaap:AmortizationOfIntangibleAssets","l":"Amortization of Intangible Assets","ytd":false,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":true,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWit