      "margin_pct": [
        0.2,
        1.55
      ],
      "margin_text": " from and after the Third Amendment Effective Date, the Applicable Margin shall mean, as of any date of determination, a percentage per annum determined by reference to the Credit Rating Level as set forth below: | Pricing Level | Credit Rating Level | Applicable Margin for Revolving Credit Facility Term SOFR Loans | Applicable Margin for Revolving Credit Facility Base Rate Loans | Applicable Margin for Term Loan Facility Term SOFR Loans | Applicable Margin for Term Loan Facility Base Rate Loans | I | Credit Rating Level 1 | 0.675% | 0.000% | 0.750% | 0.000% | II | Credit Rating Level 2 | 0.72",
      "grid_by": "ratings",
      "fee_pct": 0.125,
      "covenants": [
        {
          "type": "leverage",
          "limit": 0.35,
          "unit": "x",
          "direction": "min",
          "maintenance": true,
          "text": "In addition and notwithstanding the foregoing in this definition, (A) if (i) the Consolidated Leverage Ratio as of the last day of any fiscal quarter is equal to or less than 0.35:1.00 and (ii) the Credit Rating Level in effect at any time is Credit Rating Level 3 or better, then the Applicable Margin for each type of Loan shall be based on the Credit Rating Level that is one level"
        },
        {
          "type": "leverage",
          "limit": 0.35,
          "unit": "x",
          "direction": "max",
          "maintenance": true,
          "text": "ter than the 50th day after the end of each of the first three quarterly periods of each fiscal year or the 95th day after the end of each fiscal year, as | 5 the case may be) and shall remain in effect until the next change to be effected pursuant to this definition and (B) in addition, if (i) the Consolidated Leverage Ratio as of the last day of any fiscal quarter is greater than 0.35:1.00 but less than or equal to"
        },
        {
          "type": "leverage",
          "limit": 0.35,
          "unit": "x",
          "direction": "max",
          "maintenance": false,
          "text": "If any Compliance Certificate referred to above is not delivered within the time periods specified above, then, until such Compliance Certificate is delivered, the Consolidated Leverage Ratio as at the end of the fiscal period that would have been covered thereby shall for the purposes of this definition be deemed to be greater than 0.35:1.00."
        },
        {
          "type": "interest_coverage",
          "limit": 1.75,
          "unit": "x",
          "direction": "min",
          "maintenance": false,
          "text": "Permit the Unencumbered Interest Coverage Ratio for any period of four aggregate consecutive fiscal quarters of the Parent REIT to be less than 1.75:1.00. 7.2 Limitation on Indebtedness ."
        },
        {
          "type": "fixed_charge",
          "limit": 1.5,
          "unit": "x",
          "direction": "min",
          "maintenance": false,
          "text": "Permit the Consolidated Fixed Charge Coverage Ratio for any period of four aggregate consecutive fiscal quarters of the Parent REIT to be less than 1.50 to 1.00."
        }
      ]
