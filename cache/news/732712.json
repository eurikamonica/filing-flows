      ]
    },
    "0000732712-26-000040": {
      "h": "July 24, 2026 Katie Magnotta",
      "q": "Verizon Delivers Record 2Q26 Results as Strategic Transformation Ignites Accelerated Growth Company Achieves Strong Growth on Key Metrics and Raises Full-Year Guidance for the Second Consecutive Quarter",
      "t": [
