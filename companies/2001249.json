{"quarters":{"2026-06-30":{"end":"2026-06-30","label":"Q1 FY27","fq":1,"fy":2027,"cal":"CY2026Q2","form":"10-Q","accn":"0001213900-26-091600","filed":"2026-08-19","doc_url":"https://www.sec.gov/Archives/edgar/data/2001249/000121390026091600/ea0302383-10q_medical.htm","index_url":"https://www.sec.gov/Archives/edgar/data/2001249/000121390026091600/0001213900-26-091600-index.htm","raw":{"revenue":1000,"cor":null,"gp":1000,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":53769,"oi":-52769,"pretax":-52666,"tax":null,"ni":-52666,"pl":null,"nci":null,"ocf":-46722,"da":542,"dep":111,"amort":431,"sbc":null,"rev_contract":null,"capex":null},"q1_end":"2026-03-31","py_end":"2025-06-30","raw_q1":{"revenue":null,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":42397,"oi":-42397,"pretax":-45875,"tax":null,"ni":-45875,"pl":null,"nci":null,"ocf":-17536,"da":1736,"dep":981,"amort":755,"sbc":0,"rev_contract":null,"capex":null},"raw_py":{"revenue":null,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":61378,"costs_total":null,"opex_total":70291,"oi":-70291,"pretax":-70291,"tax":null,"ni":-70291,"pl":null,"nci":null,"ocf":-78583,"da":2881,"dep":2274,"amort":607,"sbc":2000,"rev_contract":null,"capex":null},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"ga":[{"heading":null,"text":"Selling, general and administrative expenses for the three months ended June 30, 2026 and 2025 was $48,227 and $61,378, respectively, a decrease of $13,151, or 21%. Selling, general and administrative expenses decreased in the current year period primarily due to decreased professional fees and legal fees during the current year period."}],"sga":[{"heading":null,"text":"Selling, general and administrative expenses for the three months ended June 30, 2026 and 2025 was $48,227 and $61,378, respectively, a decrease of $13,151, or 21%. Selling, general and administrative expenses decreased in the current year period primarily due to decreased professional fees and legal fees during the current year period."}],"net":[{"heading":null,"text":"The net loss for the three months ended June 30, 2026 and 2025 was ($52,666) and ($70,291), respectively, a decrease in the net loss of $17,625, or 25%. The net loss for the current year period decreased primarily due to lower selling, general and administrative expenses and depreciation and amortization during the current year period."}],"ocf":[{"heading":null,"text":"For us to eliminate substantial doubt about our ability to continue as a going concern, we must achieve profitability, generate positive cash flows from operating activities and obtain the necessary debt or equity funding to meet our projected capital investment requirements. Our management\u2019s plans with respect to this uncertainty consist of raising additional capital by issuing debt or equity securities and increasing the sales of our products and services. There can be no assurance, however, that we will be able to raise sufficient additional capital or that revenues will increase rapidly enough to offset operating losses. If we are unable to increase revenues or obtain additional financing, we will be unable to continue the development of our products and services and may have to cease operations."}],"da":[{"heading":null,"text":"Depreciation and amortization expense for the three months ended June 30, 2026 and 2025 was $542 and $2,881, respectively, a decrease of $2,339, or 81%. Depreciation decreased in the current year period primarily due to the sale of property and equipment in July 2025, March 2026 and April 2026. Amortization decreased in the current year period as a result of the derecognition of the legacy website in March 2026."}],"wc":[{"heading":null,"text":"As of June 30, 2026, we had $3,089 in cash and a working capital deficit of $238,799."}],"capex":[{"heading":null,"text":"Gain on disposal of property and equipment for the three months ended June 30, 2026 and 2025 was $103 and $0, respectively, an increase of $103. Gain on disposal of property and equipment increased in the current year period due to the sale of property and equipment in the current year period."}]},"capex_src":null,"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"gp":{"c":"us-gaap:GrossProfit","l":"Gross Profit","ytd":false,"how":"xbrl"},"opex_total":{"c":"us-gaap:OperatingExpenses","l":"Operating Expenses","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating Income (Loss)","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest","l":"Income (Loss) from Continuing Operations before Income Taxes, Noncontrolling Interest","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net loss","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net cash used in operating activities","ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationDepletionAndAmortization","l":"Depreciation, Depletion and Amortization","ytd":false,"how":"xbrl"},"dep":{"c":"us-gaap:Depreciation","l":"Depreciation","ytd":false,"how":"xbrl"},"amort":{"c":"us-gaap:AmortizationOfIntangibleAssets","l":"Amortization of Intangible Assets","ytd":false,"how":"xbrl"}},"co_fcf":null,"co_status":"no_release","co_errors":0,"co_tried":1}},"dims_ytd":{"2026-06-30":{}},"profile":{"cik":2001249,"name":"MEDICAL EXERCISE INC.","tickers":["MDXR"],"exchanges":["OTC"],"sic":"8000","industry":"Services-Health Services","sector":"health","fye":"0331","state":"FL","category":"Non-accelerated filer<br>Smaller reporting company<br>Emerging growth company"},"periods":{"q":["2024-06-30","2024-09-30","2024-12-31","2025-03-31","2026-06-30"],"fy":["2025-03-31"]},"intro":{"text":"During the fiscal year ended March 31, 2026, Medical Exercise Inc. (the \"Company,\" \"we,\" \"us,\" or \"our\") executed a comprehensive strategic pivot from its legacy direct owner/operator clinic model to an international franchising model. Historically, the Company owned and operated spinal care and back pain clinics\u2014including a trial clinical operation in North Palm Beach, Florida\u2014relying on localized operations, direct property management, and proprietary mechanical spinal strengthening technology. Following a strategic review, management identified significant scaling constraints in the legacy model, including high capital expenditure requirements, localized labor pressures, and high operational friction. Concurrently, management identified accelerating consumer demand within the global preventative health, wellness, and healthy lifespan sectors.","url":"https://www.sec.gov/Archives/edgar/data/2001249/000121390026073032/ea0295808-10k_medical.htm","filed":"2026-06-29","source":"10-K"},"keep":7,"hist":2,"da_v":2,"quality":{"v":7,"unit":"USD","q":[{"end":"2024-09-30","start":"2024-06-30","label":"Q2 FY25","ni":-61534,"basis":"ni","ocf":-37137,"assets_open":null,"assets_close":null,"wc":{"rev":0,"cor":0,"days":92,"ar_o":null,"ar_c":null,"inv_o":null,"inv_c":null,"ap_o":null,"ap_c":null,"ap_proxy":false,"has_inv":false,"dso":null,"dio":null,"dpo":null,"ccc":null},"bridge":{"start":-61534,"basis":"ni","items":[["da",2944,[4,"3m",[0]]],["impair",0,[5,"ytd",[0,1]]],["gain_dis",-389,[6,"3m",[0]]],["d_ap",21843,[7,"ytd",[0,1]]],["d_contract",0,[8,"ytd",[0,1]]],["d_tax",0,[9,"ytd",[0,1]]]],"ocf":-37137,"residual":-1,"ref":{"start":[0,"3m",[0]],"ocf":[1,"ytd",[0,1]]}},"ev":{"rev":[2,"ytd",[0,1]],"cor":[3,"ytd",[0,1]],"ni":[0,"3m",[0]],"ocf":[1,"ytd",[0,1]]}},{"end":"2024-12-31","start":"2024-09-30","label":"Q3 FY25","ni":-141207,"basis":"ni","ocf":-41441,"assets_open":null,"assets_close":null,"wc":{"rev":0,"cor":0,"days":92,"ar_o":null,"ar_c":null,"inv_o":null,"inv_c":null,"ap_o":null,"ap_c":null,"ap_proxy":false,"has_inv":false,"dso":null,"dio":null,"dpo":null,"ccc":null},"bridge":{"start":-141207,"basis":"ni"