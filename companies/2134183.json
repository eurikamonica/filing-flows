{"quarters":{"2026-06-30":{"end":"2026-06-30","label":"Q1 FY27","fq":1,"fy":2027,"cal":"CY2026Q2","form":"10-Q","accn":"0001104659-26-101088","filed":"2026-08-26","doc_url":"https://www.sec.gov/Archives/edgar/data/2134183/000110465926101088/none-20260630x10q.htm","index_url":"https://www.sec.gov/Archives/edgar/data/2134183/000110465926101088/0001104659-26-101088-index.htm","raw":{"revenue":277800000,"cor":229200000,"gp":48600000,"rd":null,"sm":null,"ga":null,"sga":27500000,"costs_total":null,"opex_total":null,"oi":19400000,"pretax":20200000,"tax":4200000,"ni":15600000,"pl":16000000,"nci":400000,"ocf":6500000,"da":7000000,"dep":7000000,"amort":null,"sbc":500000,"rev_contract":277800000,"capex":8600000,"nii":null,"int_inc":null,"int_exp":null,"nonii":null,"prov":null,"nonint_exp":null},"q1_end":null,"py_end":"2025-06-30","raw_q1":null,"raw_py":{"revenue":285500000,"cor":232800000,"gp":52700000,"rd":null,"sm":null,"ga":null,"sga":28800000,"costs_total":null,"opex_total":null,"oi":20400000,"pretax":20200000,"tax":7900000,"ni":11800000,"pl":12300000,"nci":500000,"ocf":27700000,"da":7700000,"dep":7700000,"amort":null,"sbc":-500000,"rev_contract":285500000,"capex":7300000,"nii":null,"int_inc":null,"int_exp":null,"nonii":null,"prov":null,"nonint_exp":null},"lines_struct":{"leaves":[{"id":"none:HeavyDutyEquipmentMember","label":"Heavy-Duty Equipment"},{"id":"none:CommercialVehicleMember","label":"Commercial Vehicle"},{"id":"none:AutomotiveMember","label":"Automotive"}],"groups":[],"axis":"StatementBusinessSegmentsAxis"},"lines":{"none:HeavyDutyEquipmentMember":132700000.0,"none:CommercialVehicleMember":81000000.0,"none:AutomotiveMember":64100000.0},"lines_py":{"none:HeavyDutyEquipmentMember":132700000.0,"none:CommercialVehicleMember":86900000.0,"none:AutomotiveMember":65900000.0},"notes":{"gp":[{"heading":null,"text":"As a result of lower sales and higher cost of sales as a percentage of sales, first quarter gross profit decreased $4.1 million and gross margin declined 100 basis points to 17.5 percent."}],"cor":[{"heading":null,"text":"First quarter cost of sales decreased $3.6 million, or 2 percent, primarily due to lower sales volume and improved operating efficiencies, partially offset by a $3.2 million unfavorable impact of foreign currency exchange rates. As a percentage of sales, cost of sales increased 100 basis points to 82.5 percent, primarily due to the unfavorable impact of lower sales, partially offset by improved operating efficiencies."}],"oi":[{"heading":null,"text":"Operating income of $19.4 million in the first quarter of fiscal 2027 decreased $1.0 million compared with the first quarter of fiscal 2026, primarily due to lower gross profit, partially offset by lower restructuring and SG&A expenses."}],"nonop":[{"heading":null,"text":"Other income increased $1.0 million compared with the first quarter of fiscal 2026, primarily due to lower allocated pension costs, as Modine completed the termination of its primary U. S. pension plan during the third quarter of fiscal 2026."}],"tax":[{"heading":null,"text":"The provision for income taxes of $4.2 million decreased $3.7 million from the first quarter of fiscal 2026. The decrease was primarily due to changes in the mix and amount of foreign and U.S. earnings, as compared with the same period in the prior year."}],"ocf":[{"heading":"Operating activities","text":"Net cash provided by operating activities for the three months ended June 30, 2026 was $6.5 million, which represents a $21.2 million decrease compared with the same period in the prior year. This decrease was primarily driven by higher inventory levels in connection with strategic inventory builds associated with transferring product lines, primarily among our North America facilities."}],"capex":[{"heading":null,"text":"Capital expenditures of $8.6 million during the first three months of fiscal 2027 increased $1.3 million compared with the same period in the prior year. Capital expenditures include tooling and equipment purchases in conjunction with new and renewal programs with customers."}],"Heavy-Duty Equipment":[{"heading":null,"text":"Heavy-Duty Equipment net sales increased $2.2 million, or 2 percent, from the first quarter of fiscal 2026 to the first quarter of fiscal 2027, primarily due to a $1.7 million favorable impact of foreign currency exchange rates and higher sales volume. Compared with the first quarter of the prior year, sales in Asia and Europe increased $5.6 million and $1.4 million, respectively. Sales in the Americas decreased $7.0 million."}],"Commercial Vehicle":[{"heading":null,"text":"Commercial Vehicle net sales decreased $7.8 million, or 9 percent, from the first quarter of fiscal 2026 to the first quarter of fiscal 2027, primarily due to lower sales volume in North America resulting from market weakness. This decrease was partially offset by a $1.1 million favorable impact of foreign currency exchange rates. Compared with the first quarter of the prior year, sales in the Americas decreased $6.7 million. Sales in Europe and Asia increased $0.6 million and $0.2 million, respectively."}],"Automotive":[{"heading":null,"text":"Automotive net sales decreased $1.5 million, or 2 percent, from the first quarter of fiscal 2026 to the first quarter of fiscal 2027, primarily due to lower sales volume resulting from market weakness and our strategic exit from lower margin business, partially offset by a $1.3 million favorable impact from foreign currency exchange rate changes. Compared with the prior year, sales in the Americas, Asia, and Europe decreased $0.8 million, $0.6 million, and $0.4 million, respectively."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquireProductiveAssets","label":"Expenditures for property, plant and equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfRevenue",