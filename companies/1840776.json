      "covenants": [
        {
          "type": "fixed_charge",
          "limit": 1.2,
          "unit": "x",
          "direction": "min",
          "maintenance": true,
          "text": "Permit or suffer the Fixed Charge Coverage Ratio to be less than 1.20 to 1.0 as of the last day of any Fiscal Quarter ending on or after March 31, 2025."
        },
        {
          "type": "leverage",
          "limit": 3.25,
          "unit": "x",
          "direction": "min",
          "maintenance": false,
          "text": "“ Available Incremental Amount ” means, at any time, an aggregate principal amount of up to the sum of: (a) an unlimited amount, so long as the Net Leverage Ratio is less than or equal to 3.25 to 1.00 after giving effect on a Pro Forma Basis to the incurrence or issuance of the applicable Incremental Facility or Incremental Equivalent Debt (assuming that each applicable Incremental Facility and/or Incremental Equival"
        },
        {
          "type": "leverage",
          "limit": 3.25,
          "unit": "x",
          "direction": "max",
          "maintenance": false,
          "text": "excess of the greater of (x) $75,000,000 and (y) 50% of Applicable EBITDA (calculated at the time such Indebtedness is incurred); (w) other unsecured Indebtedness if at the time of and immediately after giving effect (including giving effect on a Pro Forma Basis) to such incurrence or issuance, the Net Leverage Ratio does not exceed 3.25 to 1.00;"
        }
      ]
    },
