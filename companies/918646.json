"ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationDepletionAndAmortization","l":"Depreciation, Depletion and Amortization","ytd":false,"how":"xbrl"},"dep":{"c":"us-gaap:Depreciation","l":"Depreciation","ytd":false,"how":"xbrl"},"amort":{"c":"us-gaap:AmortizationOfIntangibleAssets","l":"Amortization of Intangible Assets","ytd":false,"how":"xbrl"},"sbc":{"c":"us-gaap:ShareBasedCompensation","l":"Share-based Payment Arrangement, Noncash Expense","ytd":false,"how":"xbrl"},"rev_contract":{"c":"us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax","l":"Revenue from Contract with Customer, Excluding Assessed Tax","ytd":false,"how":"xbrl"},"capex":{"c":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","l":"Payments to Acquire Property, Plant, and Equipment","ytd":false,"how":"xbrl"}},"lines_struct":null,"lines":null,"lines_py":null,"notes":{}}},"da_v":2,"intro":{"text":"Eagle Materials Inc. is a leading U.S. manufacturer of heavy construction products and light building materials. Eagle\u2019s primary products, Portland Cement and Gypsum Wallboard, are essential for building, expanding and repairing roads and highways and for building and renovating residential, commercial and industrial structures across America. Eagle manufactures and sells its products through a network of more than 70 facilities spanning 21 states and is headquartered in Dallas, Texas. Visit eaglematerials.com for more information. Eagle\u2019s senior management will conduct a conference call to discuss the financial results, forward-looking information and other matters at 8:30 a.m. Eastern Time (7:30 a.m. Central Time) on Wednesday, July 29, 2026. The conference call will be webcast simultaneously on the Eagle website, eaglematerials.com .","url":"https://www.sec.gov/Archives/edgar/data/918646/000119312526322090/d127735dex991.htm","filed":"2026-07-29","source":"8-K"}}