y) was incorporated in the State of New York on June 16, 1911, as the Computing-Tabulating-Recording Co. (C-T-R), a consolidation of the Computing Scale Co. of America, the Tabulating Machine Co. and The International Time Recording Co. of New York. Since that time, IBM has focused on the intersection of business insight and technological innovation, and its operations and aims have been international in nature. This was signaled over 100 years ago, in 1924, when C-T-R changed its name to International Business Machines Corporation. And it continues today\u2014we create sustained value for clients by helping them leverage the power of hybrid cloud and artificial intelligence (AI).","url":"https://www.sec.gov/Archives/edgar/data/51143/000005114326000010/ibm-20251231.htm","filed":"2026-02-24","source":"10-K"},"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0000051143-25-000015","filed":"2025-02-25","doc_url":"https://www.sec.gov/Archives/edgar/data/51143/000005114325000015/ibm-20241231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/51143/000005114325000015/0000051143-25-000015-index.htm","period":"fy","raw":{"revenue":62753000000,"cor":27201000000,"gp":35551000000,"rd":7479000000,"sm":1173000000,"ga":null,"sga":19688000000,"costs_total":null,"opex_total":null,"oi":null,"pretax":5797000000,"tax":-218000000,"ni":6023000000,"pl":null,"nci":null,"ocf":13445000000,"da":4667000000,"dep":2168000000,"amort":2499000000,"sbc":1311000000,"capex":1048000000,"rev_contract":null},"py_end":"2023-12-31","raw_py":{"revenue":61860000000,"cor":27560000000,"gp":34300000000,"rd":6775000000,"sm":1237000000,"ga":null,"sga":19003000000,"costs_total":null,"opex_total":null,"oi":null,"pretax":8690000000,"tax":1176000000,"ni":7502000000,"pl":null,"nci":null,"ocf":13931000000,"da":4396000000,"dep":2109000000,"amort":2287000000,"sbc":1133000000,"capex":1245000000,"rev_contract":null},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPla