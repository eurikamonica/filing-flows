er of equals with HCB Bancorp, the former holding company for Harrison County Bank, and the Bank changed its name to First Harrison Bank. On March 20, 2003, the Company acquired Hometown Bancshares, Inc. (\u201cHometown\u201d), a bank holding company located in New Albany, Indiana. On December 4, 2015, the Company acquired Peoples Bancorp, Inc.","url":"https://www.sec.gov/Archives/edgar/data/1070296/000110465926037802/fcap-20251231x10k.htm","filed":"2026-03-31","source":"10-K"},"keep":7,"hist":2,"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001171843-25-001868","filed":"2025-03-31","doc_url":"https://www.sec.gov/Archives/edgar/data/1070296/000117184325001868/fcap20241231_10k.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1070296/000117184325001868/0001171843-25-001868-index.htm","period":"fy","raw":{"revenue":7059000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":null,"oi":14169000,"pretax":14169000,"tax":2216000,"ni":11940000,"pl":11953000,"nci":13000,"ocf":22345000,"da":1097000,"dep":951000,"amort":147000,"sbc":202000,"rev_contract":7059000,"capex":717000},"py_end":"2023-12-31","raw_py":{"revenue":7009000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":null,"opex_total":null,"oi":15051000,"pretax":15051000,"tax":2248000,"ni":12790000,"pl":12803000,"nci":13000,"ocf":14163000,"da":1028000,"dep":882000,"amort":147000,"sbc":252000,"rev_contract":7009000,"capex":627000},"capex_src":{"concept":"us-gaap:PaymentsToAcquirePropertyPlantAndEquipment","label":"Purchase of premises and equipment","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax","l":"Revenue from Contract with Customer, Including Assessed Tax","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"us-gaap_Operating Income Loss","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIn