onsumer protection and privacy, marketplace dynamics and the state-based insurance regulatory framework. Additional guidance or developments, including with respect to privacy, may also be forthcoming.","url":"https://www.sec.gov/Archives/edgar/data/1527469/000152746926000013/ahl-20251231.htm","filed":"2026-02-25","source":"10-K"},"years":{"2024-12-31":{"end":"2024-12-31","label":"FY2024","fy":2024,"form":"10-K","accn":"0001527469-25-000016","filed":"2025-02-24","doc_url":"https://www.sec.gov/Archives/edgar/data/1527469/000152746925000016/ahl-20241231.htm","index_url":"https://www.sec.gov/Archives/edgar/data/1527469/000152746925000016/0001527469-25-000016-index.htm","period":"fy","raw":{"revenue":20689000000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":15055000000,"opex_total":null,"oi":null,"pretax":5634000000,"tax":730000000,"ni":3461000000,"pl":4904000000,"nci":1443000000,"ocf":1876000000,"da":null,"dep":null,"amort":117000000,"sbc":null,"capex":null,"rev_contract":null},"py_end":"2023-12-31","raw_py":{"revenue":28194000000,"cor":null,"gp":null,"rd":null,"sm":null,"ga":null,"sga":null,"costs_total":23603000000,"opex_total":null,"oi":null,"pretax":4591000000,"tax":-1161000000,"ni":4665000000,"pl":5752000000,"nci":1087000000,"ocf":4983000000,"da":null,"dep":null,"amort":120000000,"sbc":null,"capex":null,"rev_contract":null},"capex_src":null,"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"costs_total":{"c":"us-gaap:BenefitsLossesAndExpenses","l":"Total benefits and expenses","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest","l":"Income before income taxes","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income tax expense (benefit)","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net Income (Loss) Attributable to Parent","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net income (loss)","ytd":false,"how":"xbrl"},"nci":{"c":"us-gaap:NetIncomeLossAttributableToNoncontrollingInterest","l":"Less: Net income (loss) attributable to noncontrolling interests","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Net cash used in operating activities","ytd":false,"how":"xbrl"},"amort":{"c":"us-gaap:AmortizationOfIntangibleAssets","l":"Amortization of Intangible Assets","ytd":false,"how":"xbrl"}},"lines_struct":null,"lines":null,"lines_py":null,"notes":{"tax":[{"heading":"Income Taxes","text":"Significant judgment is required in determining tax expense and in evaluating certain and uncertain tax positions. We recognize the tax benefit of uncertain tax positions when the position is \u201cmore likely than not\u201d to be sustained upon examination, including resolution of any related appeals or litigation processes, based on the technical merits of the position. The tax benefit is measured as the largest amount of benefit that has a greater than 50% likelihood of being realized upon ultimate settlement. If a tax position is not considered more likely than not to be sustained, then no benefits of the position are recognized. We review and evaluate our tax positions quarterly to determine whether we have uncertain tax positions that require financial statement recognition. For more information regarding income taxes, see Note 13 \u2013 Income Taxes to the consolidated financial statements.\n\nDeferred tax assets and liabilities are recognized for the expected future tax consequences of differences between the carrying amount of assets and liabilities and their respective tax bases using currently enacted tax rates. The effect on deferred tax assets and liabilities of a change in tax rates is recognized in income in the period during which the change is enacted."}]}},"2025-12-31":{"end":"2025-12-31","label":"FY2025","fy":2025,"form":"10-K","accn":"0001527469-26-000013","filed":"2026-02-2