    "0000732712-24-000062": {
      "h": "",
      "q": "Verizon delivers strong third quarter results with customer growth in mobility, extending industry leadership Achieves fixed wireless subscriber target 15 months ahead of schedule and double-digit growth in total broadband connections",
      "t": [
        "earnings"
      ]
    },
    "0000732712-24-000025": {
      "h": "",
      "q": "Verizon begins 2024 with strong wireless service revenue growth, solid cash flow and continued momentum in broadband • Earnings per share of $1.09, compared with earnings per share of $1.17 in first-quarter 2023; adjusted EPS 1 , excluding special items, of $1.15, compared with $1.20 in first-quarter 2023.",
      "t": [
