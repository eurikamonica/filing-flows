esOfElectricityToNonMemberMember":68804000.0,"basin:FertilizerAndDEFProductsMember":55900000.0,"basin:LigniteCoalMember":48096000.0,"basin:SyntheticNaturalGasMember":42056000.0,"basin:OtherByproductsMember":16895000.0,"basin:MiscellaneousMember":9416000.0,"us-gaap:ProductAndServiceOtherMember":240425000.0},"lines_py":{"basin:SalesMembersMember":555678000.0,"basin:SalesOfElectricityToNonMemberMember":59317000.0,"basin:FertilizerAndDEFProductsMember":51411000.0,"basin:LigniteCoalMember":42370000.0,"basin:SyntheticNaturalGasMember":39888000.0,"basin:OtherByproductsMember":18689000.0,"basin:MiscellaneousMember":9759000.0,"us-gaap:ProductAndServiceOtherMember":222934000.0},"notes":{"opex":[{"heading":null,"text":"\u2022 Gasification net earnings increased primarily due to higher monetization of tax credits related to the capture and sequestration of CO 2 , lower interest and other charges, and higher fertilizer and DEF revenues, partially offset by higher operating expenses related to increased cost of products sold."}],"costs":[{"heading":null,"text":"\u2022 Gasification net earnings increased primarily due to higher monetization of tax credits related to the capture and sequestration of CO 2 , lower interest and other charges, and higher fertilizer and DEF revenues, partially offset by higher operating expenses related to increased cost of products sold."}],"ga":[{"heading":null,"text":"\u25e6 Electric fuel and purchased power and Electric operations and maintenance increased largely due to increased fuel, general and administrative, and production expenses. Fuel expenses were higher as a result of higher natural gas generation and prices and higher coal expense. General and administrative expenses increased due to employee-related and software expenses and production expenses were impacted by higher contracted services, property taxes and materials."}],"sga":[{"heading":null,"text":"Selling, general and administrative increased by $1.5 million largely due to higher general and administrative expenses, partially offset by lower freight."}],"nonop":[{"heading":null,"text":"Interest and other charges increased $10.0 million mainly due to an increase in net interest expense primarily due to higher debt balances resulting from additional capital expenditures in electric utility property."}],"pretax":[{"heading":null,"text":"Income tax expense was higher primarily due to higher income before income taxes."}],"tax":[{"heading":null,"text":"Income tax expense was higher primarily due to higher income before income taxes."}],"ocf":[{"heading":null,"text":"Cash is provided by operating activities and issuance of debt. Capital expenditures comprise a significant use of cash."}],"da":[{"heading":null,"text":"Depreciation and amortization increased by $327,000 mainly due to investments in infrastructure enhancement projects to improve the availability of the Synfuels Plant."}],"capex":[{"heading":"Projected Capital Expenditures","text":"For additional information on our projected capital expenditures, see \u201cProject Capital Expenditures\u201d in the \u201cManagement\u2019s Discussion and Analysis of Financial Condition and Results of Operations\u201d section of the Prospectus."}],"Sales of electricity to non-members":[{"heading":null,"text":"\u2022 Sales of electricity to non-members increased $8.6 million primarily due to increased energy sold partially offset by lower prices. Energy sold increased 472,000 MWhs mainly due to lower member sales."}],"Lignite coal":[{"heading":null,"text":"\u25e6 Operating revenue at our Coal and Limestone Operations operating segment increased largely due to higher lignite coal sales resulting from higher average sales prices."}],"Synthetic natural gas":[{"heading":null,"text":"\u25e6 Operating revenue at our Gasification operating segment increased mainly due to higher fertilizer, DEF, and synthetic natural gas revenue. Fertilizer and synthetic natural gas sales prices were higher and DEF volumes sold increased."}],"Other":[{"heading":"Other Results","text":"Other consists of the operations of Basin Cooperative Services, certain tax adjustments, intersegment eliminations, and other activity not associated with the Electric Utility, Gasification, and Coal and Limestone Operations segments. Basin Cooperative Services provides certain nonutility property management services to Basin Electric."}]},"capex_src":{"concept":"us-gaap:PaymentsToAcquireProductiveAssets","label":"Capital expenditures","how":"xbrl"},"src":{"revenue":{"c":"us-gaap:Revenues","l":"Revenues","ytd":false,"how":"xbrl"},"cor":{"c":"us-gaap:CostOfGoodsAndServicesSold","l":"Good and services provided","ytd":false,"how":"xbrl"},"sga":{"c":"us-gaap:SellingGeneralAndAdministrativeExpense","l":"Nonelectric selling, general and administrative (includes related party of $8,407 and $7,547, respectively)","ytd":false,"how":"xbrl"},"oi":{"c":"us-gaap:OperatingIncomeLoss","l":"Operating Income (Loss)","ytd":false,"how":"xbrl"},"pretax":{"c":"us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest","l":"Income (Loss) from Continuing Operations before Income Taxes, Noncontrolling Interest","ytd":false,"how":"xbrl"},"tax":{"c":"us-gaap:IncomeTaxExpenseBenefit","l":"Income tax expense","ytd":false,"how":"xbrl"},"ni":{"c":"us-gaap:NetIncomeLoss","l":"Net margin and earnings attributable to Basin Electric","ytd":false,"how":"xbrl"},"pl":{"c":"us-gaap:ProfitLoss","l":"Net margin and earnings including noncontrolling interest","ytd":false,"how":"xbrl"},"nci":{"c":"us-gaap:NetIncomeLossAttributableToNoncontrollingInterest","l":"Net margin and earnings attributable to noncontrolling interest","ytd":false,"how":"xbrl"},"ocf":{"c":"us-gaap:NetCashProvidedByUsedInOperatingActivities","l":"Cash Provided by (Used in) Operating Activity, Including Discontinued Operation","ytd":false,"how":"xbrl"},"da":{"c":"us-gaap:DepreciationAmortizationAndAccretionNet","l":"Depreciation, Amortization